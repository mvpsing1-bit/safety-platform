<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>안전인증서 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #00838f; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #00838f; }
        .back-btn { background: #00838f; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; border: none; cursor: pointer; transition: 0.2s; }
        .back-btn:hover { opacity: 0.8; }
        .container { max-width: 1600px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-height: 700px; }
        .page-title { font-size: 24px; color: #00838f; margin-bottom: 20px; border-bottom: 2px solid #00838f; padding-bottom: 12px; }
        .btn-download { background: #006064; color: #fff; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; text-decoration: none; display: inline-block; cursor: pointer; border: none; transition: 0.2s; }
        .btn-download:hover { opacity: 0.9; }
        .empty-state { padding: 40px; text-align: center; color: #888; font-size: 15px; background: #fafafa; border-radius: 10px; border: 1px dashed #ccc; }
        
        .cat-card { margin-bottom: 16px; background: #fff; border: 1px solid #e0e0e0; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); overflow: hidden; transition: all 0.2s ease-in-out; }
        .cat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0, 131, 143, 0.12); border-color: #4dd0e1; }
        
        /* 💡 추가된 탭 메뉴 스타일 */
        .tab-menu { display: flex; border-bottom: 1px solid #ccc; background: #fff; border-radius:8px 8px 0 0; }
        .tab-btn { flex: 1; padding: 12px; border: none; background: transparent; font-size: 14px; font-weight: bold; color: #888; cursor: pointer; border-bottom: 3px solid transparent; transition: 0.2s; }
        .tab-btn.active { color: #00838f; border-bottom: 3px solid #00838f; background: #f4fbfb; }
        .tab-btn:hover:not(.active) { background: #f9f9f9; }
        .tab-content { display: none; padding: 15px 0; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>
    <header>
        <div class="brand-title">ESOL <span>안전인증서 자료실</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>
    
    <div class="container">
        <div class="page-title"><h2>📜 분야별 안전인증서 보관함</h2></div>
        <p style="font-size:14px; color:#666; margin-bottom:40px; line-height:1.6;">보호구, 방호장치 등 안전인증 및 검사 합격 증명서 모음입니다. 분류를 클릭하여 <b>인증서와 제품 사진</b>을 확인하세요.</p>
        
        <div id="certContainer"></div>
    </div>

    <script>
        async function fetchDB() {
            const res = await fetch('/api/db');
            return await res.json();
        }

        async function renderCert() {
            const db = await fetchDB();
            
            const savedCats = db['esol_cert_categories'];
            const actualCats = savedCats ? JSON.parse(savedCats) : [];

            const savedHistory = db['esol_cert_history'];
            let historyList = savedHistory ? JSON.parse(savedHistory) : [];
            const container = document.getElementById('certContainer');

            if (actualCats.length === 0 && historyList.length === 0) {
                container.innerHTML = `<div class="empty-state">등록된 안전인증서 자료가 없습니다. 관리자 페이지에서 등록해주세요.</div>`; 
                return;
            }

            historyList.sort((a, b) => b.id - a.id);

            const groupedData = {};
            actualCats.forEach(c => groupedData[c] = []);
            historyList.forEach(h => {
                if (!groupedData[h.category]) {
                    groupedData[h.category] = [];
                    actualCats.push(h.category);
                }
                groupedData[h.category].push(h);
            });

            let html = '';
            const sortedCats = [...new Set(actualCats)].sort();

            for (const cat of sortedCats) {
                const catItems = groupedData[cat];
                const catId = 'cat-' + cat.replace(/\s/g, '');
                
                html += `
                <div class="cat-card" style="margin-bottom:8px;">
                    <div style="padding:12px 16px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; border-left:4px solid #00838f;" onclick="toggleCat('${catId}')">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-size:16px;">📂</span>
                            <h3 style="margin:0; color:#222; font-size:15px; font-weight:bold;">${cat}</h3>
                            <span style="background:${catItems.length > 0 ? '#00838f' : '#e0e0e0'}; color:${catItems.length > 0 ? '#fff' : '#666'}; font-size:11px; font-weight:bold; padding:3px 8px; border-radius:12px;">자료 ${catItems.length}건</span>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <span id="icon-${catId}" style="color:#00838f; font-size:12px; font-weight:bold; background:#e0f7fa; padding:4px 8px; border-radius:6px; transition:0.2s;">▼ 펼쳐보기</span>
                        </div>
                    </div>
                    <div id="body-${catId}" style="display:none; padding:16px; background:#fafafa; border-top:1px solid #eee;">
                `;

                if (catItems.length === 0) {
                    html += `<div style="text-align:center; color:#999; font-size:14px; padding:20px; background:#fff; border-radius:8px; border:1px dashed #ddd;">등록된 내역이 없습니다.</div>`;
                } else {
                    html += catItems.map((m, idx) => {
                        const isExpanded = false; // 기본적으로 게시글은 닫아둠
                        
                        // 💡 1. 인증서 파일들 HTML 생성
                        let fileList = [];
                        if (m.files && m.files.length > 0) fileList = m.files;
                        else if (m.fileUrl) fileList = [{ fileName: m.fileName || '첨부파일', fileUrl: m.fileUrl }];
                        
                        let filesHtml = '';
                        if (fileList.length > 0) {
                            filesHtml = fileList.map((f, fIdx) => {
                                const fileId = `${m.id}-${fIdx}`;
                                const isPdf = f.fileName.toLowerCase().endsWith('.pdf');
                                const isFileExpanded = true; // 열었을 때 바로 보이게
                                
                                let previewHtml = `<div style="width:100%; height:85vh; background:#525659; border-radius:8px; border:1px solid #ccc; overflow:hidden;">`;
                                if (isPdf) { 
                                    previewHtml += `<iframe data-src="${f.fileUrl}" style="width:100%; height:100%; border:none; display:block;"></iframe>`; 
                                } else { 
                                    previewHtml += `<div style="width:100%; height:100%; overflow:auto; padding:20px; text-align:center;"><img src="${f.fileUrl}" style="max-width:100%; box-shadow:0 4px 15px rgba(0,0,0,0.5);"></div>`; 
                                }
                                previewHtml += `</div>`;
                                
                                return `<div style="margin-top:10px;">${previewHtml}</div>`;
                            }).join('');
                        } else {
                            filesHtml = `<div style="padding:20px; text-align:center; color:#888;">등록된 인증서 파일이 없습니다.</div>`;
                        }

                        // 💡 2. 제품 사진 HTML 생성
                        const photoHtml = m.photoUrl 
                            ? `<div style="text-align:center; padding:10px;"><img src="${m.photoUrl}" style="max-width:100%; max-height:600px; border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,0.1);"></div>`
                            : `<div style="padding:40px; text-align:center; color:#999; border:1px dashed #ccc; border-radius:8px;">등록된 제품 사진이 없습니다. 📭</div>`;

                        // 💡 3. 게시글 바디 조립 (탭 메뉴 포함)
                        return `
                            <div style="margin-bottom:16px; border:1px solid #e0e0e0; border-radius:10px; overflow:hidden; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,0.02);">
                                <div style="padding:16px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.2s;" onmouseover="this.style.background='#fdfdfd'" onmouseout="this.style.background='#fff'" onclick="togglePost('${m.id}')">
                                    <div style="display:flex; align-items:center; gap:15px; flex-wrap:wrap;">
                                        <h4 style="margin:0; color:#333; font-size:16px; font-weight:bold;">📑 ${m.title}</h4>
                                        <span style="color:#888; font-size:13px;">등록일: ${m.date}</span>
                                    </div>
                                    <span id="post-icon-${m.id}" style="color:#888; font-size:13px; font-weight:bold;">${isExpanded ? '▲ 게시글 접기' : '▼ 게시글 펼치기'}</span>
                                </div>
                                <div id="post-body-${m.id}" style="display:${isExpanded ? 'block' : 'none'}; padding:20px; border-top:1px solid #eee; background:#fafafa;">
                                    
                                    <!-- 💡 탭 메뉴 영역 -->
                                    <div class="tab-menu">
                                        <button class="tab-btn active" id="tabBtn-cert-${m.id}" onclick="switchTab('${m.id}', 'cert')">📄 안전 인증서 보기</button>
                                        <button class="tab-btn" id="tabBtn-photo-${m.id}" onclick="switchTab('${m.id}', 'photo')">📸 제품 현품 사진</button>
                                    </div>
                                    
                                    <!-- 💡 탭 내용 영역 -->
                                    <div class="tab-content active" id="content-cert-${m.id}">${filesHtml}</div>
                                    <div class="tab-content" id="content-photo-${m.id}">${photoHtml}</div>

                                </div>
                            </div>
                        `;
                    }).join('');
                }

                html += `</div></div>`;
            }
            container.innerHTML = html;
            
            // PDF 렌더링을 위한 후처리
            document.querySelectorAll('iframe[data-src]').forEach(iframe => {
                const base64Data = iframe.getAttribute('data-src');
                if (base64Data && base64Data.startsWith('data:application/pdf')) {
                    try {
                        const arr = base64Data.split(',');
                        const bstr = atob(arr[1]);
                        let n = bstr.length;
                        const u8arr = new Uint8Array(n);
                        while(n--) { u8arr[n] = bstr.charCodeAt(n); }
                        const blob = new Blob([u8arr], {type: 'application/pdf'});
                        iframe.src = URL.createObjectURL(blob);
                    } catch (e) {
                        iframe.src = base64Data;
                    }
                } else {
                    iframe.src = base64Data;
                }
            });
        }

        // 폴더 열기/닫기
        function toggleCat(catId) {
            const body = document.getElementById(`body-${catId}`);
            const icon = document.getElementById(`icon-${catId}`);
            if (body.style.display === 'none') { 
                body.style.display = 'block'; icon.innerText = '▲ 접기'; 
                icon.style.background = '#00838f'; icon.style.color = '#fff'; 
            } else { 
                body.style.display = 'none'; icon.innerText = '▼ 펼쳐보기'; 
                icon.style.background = '#e0f7fa'; icon.style.color = '#00838f'; 
            }
        }

        // 게시글 열기/닫기
        function togglePost(id) {
            const body = document.getElementById(`post-body-${id}`);
            const icon = document.getElementById(`post-icon-${id}`);
            if (body.style.display === 'none') { body.style.display = 'block'; icon.innerText = '▲ 게시글 접기'; } 
            else { body.style.display = 'none'; icon.innerText = '▼ 게시글 펼치기'; }
        }

        // 💡 탭(인증서 <-> 사진) 전환 함수
        window.switchTab = function(id, type) {
            document.getElementById(`tabBtn-cert-${id}`).classList.remove('active');
            document.getElementById(`tabBtn-photo-${id}`).classList.remove('active');
            document.getElementById(`tabBtn-${type}-${id}`).classList.add('active');
            
            document.getElementById(`content-cert-${id}`).classList.remove('active');
            document.getElementById(`content-photo-${id}`).classList.remove('active');
            document.getElementById(`content-${type}-${id}`).classList.add('active');
        };

        window.onload = renderCert;
    </script>
</body>
</html>