<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>안전 공지사항 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #4a0082; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #4a0082; }
        .back-btn { background: #4a0082; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; }

        .container { max-width: 1500px; margin: 0 auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .page-title { font-size: 24px; color: #4a0082; margin-bottom: 20px; border-bottom: 2px solid #4a0082; padding-bottom: 12px; }

        .doc-table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 30px; }
        .doc-table th, .doc-table td { padding: 14px; border-bottom: 1px solid #eee; text-align: left; font-size: 15px; vertical-align: middle; }
        .doc-table th { background: #f8f5fc; color: #4a0082; font-weight: bold; }
        
        .btn-action { padding: 8px 14px; border-radius: 6px; border: none; font-size: 13px; font-weight: bold; cursor: pointer; margin-right: 6px; transition: 0.2s; }
        .btn-action:hover { opacity: 0.9; }
        .btn-view { background: #4a0082; color: white; }

        /* 📢 공지사항 모달 전용 스타일 */
        .notice-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: none; justify-content: center; align-items: center; z-index: 3000; }
        .notice-modal-box { background: #fff; padding: 32px; border-radius: 16px; width: 650px; max-width: 90%; max-height: 80vh; overflow-y: auto; }
    </style>
</head>
<body>

    <header>
        <div class="brand-title">ESOL <span>환경안전보건 플랫폼</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>

    <div class="container">
        <div class="page-title">
            <h2>📢 안전 공지사항</h2>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h3 style="color:#4a0082;">📋 전체 공지사항 목록</h3>
            <span style="font-size:13px; color:#666;">※ 공지사항 등록 및 수정/삭제는 <strong>관리자 페이지</strong>에서 가능합니다.</span>
        </div>
        
        <table class="doc-table">
            <thead>
                <tr>
                    <th style="width: 10%;">구분</th>
                    <th style="width: 50%;">제목 (클릭하여 본문 열람)</th>
                    <th style="width: 15%;">작성자</th>
                    <th style="width: 15%;">등록일</th>
                    <th style="width: 10%;">본문보기</th>
                </tr>
            </thead>
            <tbody id="noticeListBody"></tbody>
        </table>
    </div>

    <!-- 📢 공지사항 본문 열람 팝업 모달 -->
    <div class="notice-modal" id="noticeModal">
        <div class="notice-modal-box">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #4a0082; padding-bottom:12px; margin-bottom:16px;">
                <div>
                    <span id="modalNoticeTag" style="background:#b0268d; color:#fff; padding:4px 10px; border-radius:12px; font-weight:bold; font-size:12px; margin-right:8px;">필독</span>
                    <strong id="modalNoticeDate" style="color:#888; font-size:13px;">2026-07-20</strong>
                </div>
                <button onclick="closeNoticeModal()" style="background:none; border:none; font-size:20px; cursor:pointer; font-weight:bold; color:#777;">✕</button>
            </div>
            <h2 id="modalNoticeTitle" style="color:#4a0082; font-size:20px; margin-bottom:12px;">공지사항 제목</h2>
            <p style="font-size:13px; color:#666; margin-bottom:20px;">작성자: <span id="modalNoticeWriter" style="font-weight:bold; color:#333;">안전관리자</span></p>
            <div id="modalNoticeContent" style="background:#f8f9fa; padding:20px; border-radius:8px; min-height:180px; white-space:pre-wrap; line-height:1.6; font-size:15px; color:#222; border:1px solid #eee;"></div>
            <div style="text-align:right; margin-top:20px;">
                <button class="btn-action btn-view" onclick="closeNoticeModal()">확인 및 닫기</button>
            </div>
        </div>
    </div>

    <script>
        const defaultNotices = [
            { id: 1, tag: '필독', title: '2026년 상반기 작업환경측정 결과 공고의 건', content: '측정이 완료되었습니다.', writer: '환경안전팀', date: '2026-07-20' },
            { id: 2, tag: '안내', title: '신규 화학물질 도입에 따른 MSDS 최신화 게시', content: '신규 가공 라인에 도입된 화학물질에 대한 MSDS(물질안전보건자료)가 최신화되었습니다.\n작업 전 반드시 숙지하시기 바랍니다.', writer: '보건관리자', date: '2026-07-18' }
        ];

        function getNotices() {
            const saved = localStorage.getItem('esol_notices');
            return saved ? JSON.parse(saved) : defaultNotices;
        }

        function renderNoticeList() {
            const list = getNotices();
            const tbody = document.getElementById('noticeListBody');

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#999; padding:30px;">등록된 공지사항이 없습니다.</td></tr>`;
                return;
            }

            tbody.innerHTML = list.map(n => `
                <tr style="cursor:pointer;" onclick="openNoticeModal(${n.id})">
                    <td><span style="background:#b0268d; color:#fff; padding:3px 8px; border-radius:10px; font-weight:bold; font-size:12px;">${n.tag || '공지'}</span></td>
                    <td><strong style="color:#4a0082;">${n.title}</strong></td>
                    <td>${n.writer || '관리자'}</td>
                    <td>${n.date}</td>
                    <td><button class="btn-action btn-view" onclick="event.stopPropagation(); openNoticeModal(${n.id})">📖 본문 열람</button></td>
                </tr>
            `).join('');
        }

        function openNoticeModal(id) {
            const list = getNotices();
            const target = list.find(n => n.id === id);
            if (!target) return;

            document.getElementById('modalNoticeTag').innerText = target.tag || '공지';
            document.getElementById('modalNoticeTitle').innerText = target.title;
            document.getElementById('modalNoticeDate').innerText = target.date;
            document.getElementById('modalNoticeWriter').innerText = target.writer || '관리자';
            document.getElementById('modalNoticeContent').innerText = target.content;

            document.getElementById('noticeModal').style.display = 'flex';
        }

        function closeNoticeModal() {
            document.getElementById('noticeModal').style.display = 'none';
        }

        // 페이지 로드 시 즉시 목록 렌더링
        window.onload = renderNoticeList;
    </script>
</body>
</html>