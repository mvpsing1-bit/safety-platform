<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Today's DRI - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #4a0082; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #4a0082; }
        .back-btn { background: #4a0082; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; }

        .container { max-width: 1500px; margin: 0 auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .page-title { font-size: 24px; color: #4a0082; margin-bottom: 20px; border-bottom: 2px solid #4a0082; padding-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }

        .btn-action { padding: 8px 14px; border-radius: 6px; border: none; font-size: 13px; font-weight: bold; cursor: pointer; margin-right: 6px; transition: 0.2s; }
        .btn-action:hover { opacity: 0.9; }

        .dri-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; text-align: center; }
        .dri-table th, .dri-table td { padding: 10px 12px; border: 1px solid #eae2f0; }
        .dri-table th { background: #fffbee; color: #c62828; font-weight: bold; }
        .dri-table td { background: #fff; vertical-align: middle; }

        .search-box { display: flex; align-items: center; background: #f8f5fc; border: 2px solid #4a0082; border-radius: 30px; padding: 5px 15px; width: 350px; }
        .search-box input { border: none; background: transparent; outline: none; padding: 8px; width: 100%; font-size: 14px; }
        .search-box span { font-size: 18px; color: #4a0082; }
    </style>
</head>
<body>
    <header>
        <div class="brand-title">ESOL <span>환경안전보건 플랫폼</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>

    <div class="container">
        <div class="page-title">
            <h2>📂 Today's DRI (일일 위험작업 현황)</h2>
            <div class="search-box">
                <span>🔍</span><input type="text" id="driSearchInput" placeholder="날짜, 부서, 작업내용, 장소 검색..." onkeyup="searchDri()">
            </div>
        </div>

        <div style="margin-bottom:20px;">
            <p style="font-size:14px; color:#666; margin-top:8px;">각 날짜의 막대를 클릭하면 해당 일자의 위험작업 리스트가 펼쳐집니다.<br>(위험요소나 안전대책이 없는 항목은 N/A로 표기되며 페이지별 탐색이 가능합니다.)</p>
        </div>
        
        <div id="driAccordionContainer"></div>
        <div id="driPagination" style="display:flex; justify-content:center; gap:5px; margin-top:25px;"></div>
    </div>

    <script>
        async function fetchDB() { const res = await fetch('/api/db'); return await res.json(); }

        let driCurrentPage = 1;
        const driPerPage = 5;

        function searchDri() {
            driCurrentPage = 1;
            renderDriSection(1);
        }

        async function renderDriSection(page = 1) {
            driCurrentPage = page;
            const searchKeyword = document.getElementById('driSearchInput').value.trim().toLowerCase();
            
            const db = await fetchDB();
            let list = db['esol_dri_data'] ? JSON.parse(db['esol_dri_data']) : [];
            
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
            list = list.filter(d => new Date(d.date) >= oneYearAgo);

            if (searchKeyword) {
                list = list.filter(d => 
                    d.date.includes(searchKeyword) || d.dept.toLowerCase().includes(searchKeyword) || 
                    d.task.toLowerCase().includes(searchKeyword) || d.location.toLowerCase().includes(searchKeyword)
                );
            }

            const grouped = {};
            list.forEach(d => {
                if(!grouped[d.date]) grouped[d.date] = [];
                grouped[d.date].push(d);
            });

            const sortedDates = Object.keys(grouped).sort((a,b) => new Date(b) - new Date(a));
            const container = document.getElementById('driAccordionContainer');
            const paginationContainer = document.getElementById('driPagination');

            if(sortedDates.length === 0) {
                container.innerHTML = '<div style="text-align:center; color:#999; padding:30px; background:#faf8fc; border: 1px solid #eae2f0; border-radius:12px;">조건에 일치하는 DRI 기록이 없습니다.</div>';
                paginationContainer.innerHTML = ''; return;
            }

            const totalPages = Math.ceil(sortedDates.length / driPerPage);
            if (driCurrentPage > totalPages) driCurrentPage = totalPages;
            if (driCurrentPage < 1) driCurrentPage = 1;

            const startIndex = (driCurrentPage - 1) * driPerPage;
            const currentDates = sortedDates.slice(startIndex, startIndex + driPerPage);

            container.innerHTML = currentDates.map((date, index) => {
                const isExpanded = (index === 0 && driCurrentPage === 1 && !searchKeyword); 
                const items = grouped[date];

                return `
                <div style="margin-bottom:12px; border:2px solid ${isExpanded ? '#ffcdd2' : '#eae2f0'}; border-radius:12px; overflow:hidden; background:#fff;">
                    <div style="background:${isExpanded ? '#fffbee' : '#faf8fc'}; padding:16px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center;" onclick="toggleDriDate('${date}')">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <h4 style="color:${isExpanded ? '#c62828' : '#4a0082'}; font-size:16px; margin:0;">📅 ${date} 위험작업 내역</h4>
                            <span style="background:#e0e0e0; color:#555; padding:4px 8px; border-radius:12px; font-size:12px; font-weight:bold;">총 ${items.length}건</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:15px;">
                            <button class="btn-action" style="background:#d32f2f; color:#fff; margin:0; padding:8px 16px;" onclick="event.stopPropagation(); copyDriEmailByDate('${date}')">📧 메일 양식 복사</button>
                            <span id="icon-${date}" style="font-size:14px; font-weight:bold; color:#888;">${isExpanded ? '▲ 접기' : '▼ 펴기'}</span>
                        </div>
                    </div>
                    
                    <div id="table-${date}" style="display:${isExpanded ? 'block' : 'none'}; padding:20px; border-top:1px solid #eae2f0;">
                        <table class="dri-table">
                            <thead>
                                <tr>
                                    <!-- 💡 위험도를 맨 앞으로 이동 -->
                                    <th style="width: 10%;">위험도</th>
                                    <th style="width: 10%;">부서</th>
                                    <th style="width: 12%;">장소(설비)</th>
                                    <th style="width: 12%;">작업시간</th>
                                    <th style="width: 20%;">작업내용</th>
                                    <th style="width: 18%;">위험요소</th>
                                    <th style="width: 18%;">안전대책</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${items.map(d => {
                                    const displayTime = (d.startTime && d.endTime) ? `${d.startTime} ~ ${d.endTime}` : (d.time || '-');
                                    const isNone = (d.task.trim() === '없음');
                                    
                                    let levelBadge = '';
                                    if (d.level === '고위험') levelBadge = '<span style="display:inline-block; background:#ffebee; color:#c62828; padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; border:1px solid #ffcdd2;">🔴 고위험</span>';
                                    else if (d.level === '중위험') levelBadge = '<span style="display:inline-block; background:#fff8e1; color:#f57f17; padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; border:1px solid #ffe082;">🟡 중위험</span>';
                                    else if (d.level === '저위험') levelBadge = '<span style="display:inline-block; background:#e8f5e9; color:#2e7d32; padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; border:1px solid #a5d6a7;">🟢 저위험</span>';

                                    const riskTags = d.risk ? d.risk.split(/[,\n]+/).map(t => t.trim()).filter(t => t && t !== '없음' && t !== '해당없음').map(t => `<div style="background:#ffebee; color:#c62828; padding:3px 6px; border-radius:4px; margin-bottom:3px; font-size:12px; display:inline-block; border:1px solid #ffcdd2; margin-right:3px;">${t}</div>`).join('') : '';
                                    const measureTags = d.measure ? d.measure.split(/[,\n]+/).map(t => t.trim()).filter(t => t && t !== '없음' && t !== '해당없음').map(t => `<div style="background:#e3f2fd; color:#1565c0; padding:3px 6px; border-radius:4px; margin-bottom:3px; font-size:12px; display:inline-block; border:1px solid #bbdefb; margin-right:3px;">${t}</div>`).join('') : '';
                                    
                                    return `
                                    <tr style="${isNone ? 'background-color:#fafafa; color:#888;' : ''}">
                                        <!-- 💡 데이터 셀(td)도 위험도를 첫 번째로! -->
                                        <td style="text-align:center; vertical-align:middle;">${!isNone ? levelBadge : '-'}</td>
                                        <td style="vertical-align:middle;"><strong>${d.dept}</strong></td>
                                        <td style="vertical-align:middle;">${d.location || '-'}</td>
                                        <td style="vertical-align:middle; font-weight:bold; color:${isNone ? '#888' : '#006064'};">${displayTime}</td>
                                        <td style="text-align:left; vertical-align:middle; font-weight:${isNone ? 'normal' : 'bold'}; color:${isNone ? '#888' : '#222'};">${d.task.replace(/\n/g, '<br>')}</td>
                                        <td style="text-align:left; vertical-align:middle;">${riskTags || '<span style="color:#999; font-style:italic;">-</span>'}</td>
                                        <td style="text-align:left; vertical-align:middle;">${measureTags || '<span style="color:#999; font-style:italic;">-</span>'}</td>
                                    </tr>`;
                                }).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>`;
            }).join('');

            let pageHtml = '';
            for (let i = 1; i <= totalPages; i++) {
                pageHtml += `<button onclick="renderDriSection(${i})" style="padding:6px 14px; border:1px solid #4a0082; background:${i === driCurrentPage ? '#4a0082' : '#fff'}; color:${i === driCurrentPage ? '#fff' : '#4a0082'}; border-radius:6px; cursor:pointer; font-weight:bold;">${i}</button>`;
            }
            paginationContainer.innerHTML = pageHtml;
        }

        function toggleDriDate(date) {
            const tableDiv = document.getElementById(`table-${date}`);
            const icon = document.getElementById(`icon-${date}`);
            if(tableDiv.style.display === 'none') { tableDiv.style.display = 'block'; icon.innerText = '▲ 접기'; } 
            else { tableDiv.style.display = 'none'; icon.innerText = '▼ 펴기'; }
        }

        // 💡 [핵심 교체] HTTP 사내망 환경에서도 서식을 유지하며 복사하는 강력한 2단 우회 함수!
        async function copyDriEmailByDate(targetDate) {
            const db = await fetchDB();
            const list = db['esol_dri_data'] ? JSON.parse(db['esol_dri_data']) : [];
            const targetDri = list.filter(d => d.date === targetDate);

            if (targetDri.length === 0) return alert('데이터를 찾을 수 없습니다.');

            const tableRows = targetDri.map(d => {
                const displayTime = (d.startTime && d.endTime) ? `${d.startTime} ~ ${d.endTime}` : (d.time || '-');
                const isNone = (d.task.trim() === '없음');
                
                const emailRisks = d.risk ? d.risk.split(/[,\n]+/).map(t => t.trim()).filter(t => t && t !== '없음' && t !== '해당없음').map(t => `- ${t}`).join('<br>') : '';
                const emailMeasures = d.measure ? d.measure.split(/[,\n]+/).map(t => t.trim()).filter(t => t && t !== '없음' && t !== '해당없음').map(t => `- ${t}`).join('<br>') : '';
                
                const rawLevel = d.level || '저위험';
                let emailLevel = '';
                let levelColor = '';
                
                if (rawLevel === '고위험') { emailLevel = '🔴 고위험'; levelColor = '#c62828'; } 
                else if (rawLevel === '중위험') { emailLevel = '🟡 중위험'; levelColor = '#e65100'; } 
                else { emailLevel = '🟢 저위험'; levelColor = '#2e7d32'; }
                
                return `<tr style="${isNone ? 'color:#777;' : ''}">
                    <!-- 💡 메일 양식 데이터: 위험도가 가장 첫 번째 <td>로 이동! -->
                    <td style="border: 1px solid #bbb; padding: 6px 8px; text-align:center; vertical-align:middle; font-weight:bold; color:${!isNone ? levelColor : '#777'}; white-space:nowrap;">${!isNone ? emailLevel : '-'}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; text-align:center; vertical-align:middle; white-space:nowrap;">${d.date}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; text-align:center; vertical-align:middle; white-space:nowrap;"><strong>${d.dept}</strong></td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; text-align:center; vertical-align:middle; white-space:nowrap;">${d.location || '-'}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; text-align:center; vertical-align:middle; white-space:nowrap; font-weight:${isNone ? 'normal' : 'bold'};">${displayTime}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; vertical-align:middle;">${d.task.replace(/\n/g, '<br>')}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; color:${isNone ? '#777' : '#d32f2f'}; font-weight:bold; vertical-align:middle; font-size:9pt;">${emailRisks || '-'}</td>
                    <td style="border: 1px solid #bbb; padding: 6px 8px; color:${isNone ? '#777' : '#1976d2'}; font-weight:bold; vertical-align:middle; font-size:9pt;">${emailMeasures || '-'}</td>
                </tr>`;
            }).join('');

            const emailHtml = `
                <div style="font-family: 'Malgun Gothic', '맑은 고딕', sans-serif; font-size: 10pt; color: #333;">
                    <p>안녕하세요.<br>환경안전부서 입니다.</p>
                    <p>각 부서별 DRI(Daily Risk Inspection) 회의 결과, <strong>[${targetDate}]</strong> 위험작업 공유드립니다.<br>이후 돌발작업 발생 시 환경안전으로 연락 부탁드립니다.</p><br>
                    <table style="width: auto; max-width: 100%; border-collapse: collapse; font-size: 10pt;">
                        <!-- 💡 메일 양식 헤더: <th>위험도</th>를 맨 앞으로 이동! -->
                        <thead style="background-color: #f4f5f9;"><tr><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">위험도</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">일시</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">부서</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">장소(설비)</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">작업시간</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">작업내용</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">위험요소</th><th style="border: 1px solid #bbb; padding: 8px; white-space: nowrap;">안전대책</th></tr></thead>
                        <tbody>${tableRows}</tbody>
                    </table>
                    <br><p>감사합니다.</p>
                </div>
            `;

            // [1] 최신 API가 지원되고 (HTTPS/Localhost), 클립보드 아이템 기능이 있는 경우
            if (navigator.clipboard && window.isSecureContext && typeof ClipboardItem !== 'undefined') {
                try {
                    const blob = new Blob([emailHtml], { type: 'text/html' });
                    const clipboardItem = new ClipboardItem({ 'text/html': blob });
                    
                    await navigator.clipboard.write([clipboardItem]);
                    alert(`📧 ${targetDate} 기준의 메일 양식이 클립보드에 완벽하게 복사되었습니다! (Ctrl+V 로 붙여넣기 하세요)`);
                    return; // 성공 시 여기서 종료
                } catch (err) {
                    console.log('최신 복사 방식 실패, 우회 방식 시도', err);
                    // 실패 시 아래 구형 방식으로 떨어짐
                }
            }
            
            // [2] 사내망 HTTP 환경이거나 최신 API가 막힌 경우 동작하는 구형 우회 방식 (Fallback)
            fallbackCopyRichText(emailHtml, targetDate);
        }

        // 💡 서식(테이블, 글자색)을 그대로 유지하면서 배경색 찌꺼기를 없앤 완벽한 우회 함수!
        function fallbackCopyRichText(htmlContent, targetDate) {
            // 1. 화면 밖 안 보이는 곳에 아주 작은 임시 영역 생성 (복사 이벤트를 발생시키기 위한 미끼)
            const tempDiv = document.createElement('div');
            tempDiv.textContent = "copy"; 
            tempDiv.style.position = 'absolute';
            tempDiv.style.left = '-9999px';
            document.body.appendChild(tempDiv);

            // 2. 해당 영역을 선택(드래그) 상태로 만듦
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(tempDiv);
            selection.removeAllRanges();
            selection.addRange(range);

            // 💡 3. 핵심! 브라우저가 멋대로 화면(배경색)을 복사하려는 순간 낚아채서, 깨끗한 HTML만 클립보드에 꽂아 넣음!
            function copyHandler(event) {
                event.clipboardData.setData('text/html', htmlContent);
                event.preventDefault(); // 기본 복사 동작(배경색이 묻어가는 현상)을 완벽 차단
            }

            // 복사 이벤트 낚아채기 시작
            document.addEventListener('copy', copyHandler);

            try {
                // 강제 복사 명령 실행 (이 순간 위의 copyHandler가 작동하며 깨끗한 내용만 복사됨)
                const successful = document.execCommand('copy');
                if (successful) {
                    alert(`📧 ${targetDate} 기준의 메일 양식이 복사되었습니다!\n아웃룩이나 메일에 붙여넣기(Ctrl+V) 하세요.`);
                } else {
                    alert('복사에 실패했습니다. 브라우저 보안 설정을 확인해 주세요.');
                }
            } catch (err) {
                alert('복사 기능을 지원하지 않는 브라우저입니다.');
            } finally {
                // 4. 작업이 끝나면 낚아채기 종료 및 임시 박스 흔적 지우기
                document.removeEventListener('copy', copyHandler);
                selection.removeAllRanges();
                document.body.removeChild(tempDiv);
            }
        }

        window.onload = () => renderDriSection(1);
    </script>
</body>
</html>