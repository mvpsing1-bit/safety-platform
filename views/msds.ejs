<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSDS 즉시조회 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #4a0082; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #4a0082; }
        .back-btn { background: #4a0082; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; }

        .container { max-width: 1500px; margin: 0 auto; background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .page-title { font-size: 24px; color: #4a0082; margin-bottom: 20px; border-bottom: 2px solid #4a0082; padding-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }

        .search-box { display: flex; align-items: center; background: #f8f5fc; border: 2px solid #b0268d; border-radius: 30px; padding: 8px 20px; width: 400px; }
        .search-box input { border: none; background: transparent; outline: none; padding: 8px; width: 100%; font-size: 15px; }
        
        .doc-table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 30px; }
        .doc-table th, .doc-table td { padding: 14px; border-bottom: 1px solid #eee; text-align: left; font-size: 15px; vertical-align: middle; }
        .doc-table th { background: #f8f5fc; color: #4a0082; font-weight: bold; }
        
        .btn-action { padding: 8px 14px; border-radius: 6px; border: none; font-size: 13px; font-weight: bold; cursor: pointer; margin-right: 6px; transition: 0.2s; }
        .btn-action:hover { opacity: 0.9; }
        .btn-view { background: #b0268d; color: white; }

        .tag-badge { background: #ffebee; color: #c62828; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; margin-right: 6px; border: 1px solid #ffcdd2; display: inline-block; margin-bottom: 4px; }
    </style>
</head>
<body>
    <header class="no-print">
        <div class="brand-title">ESOL <span>환경안전보건 플랫폼</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>

    <div class="container">
        <div class="page-title">
            <h2>🧪 MSDS 및 공정별 관리요령 즉시 조회</h2>
            <div class="search-box">
                <span style="font-size:20px; color:#b0268d;">🔍</span><input type="text" id="msdsSearchInput" placeholder="물질명, CAS No, 유해성 태그 검색..." onkeyup="renderMsdsList()">
            </div>
        </div>

        <p style="font-size:14px; color:#666; margin-bottom:20px;">현장에서 취급하는 화학물질의 <strong>MSDS</strong> 및 <strong>공정별 관리요령</strong>을 즉시 검색하고 열람할 수 있습니다. <br>물질명이나 CAS 번호를 검색창에 입력하세요.</p>

        <table class="doc-table">
            <thead><tr><th style="width: 15%;">화학물질명</th><th style="width: 12%;">CAS No.</th><th style="width: 13%;">공급업체</th><th style="width: 30%;">주요 유해·위험성 태그</th><th style="width: 30%;">자료 열람 (선택)</th></tr></thead>
            <tbody id="msdsListBody"></tbody>
        </table>

        <div id="pdfViewerArea" style="display:none; background:#2a2a2e; padding:20px; border-radius:12px; margin-top:20px;">
            <div style="display:flex; justify-content:space-between; color:#fff; margin-bottom:10px;">
                <h3 id="viewingDocTitle" style="color:#fee500;">📄 MSDS 뷰어</h3>
                <button onclick="closeViewer()" style="background:#e53935; color:#fff; border:none; padding:6px 12px; border-radius:6px; cursor:pointer;">✕ 닫기</button>
            </div>
            <iframe id="pdfFrame" style="width:100%; height:850px; border:none; background:#fff; border-radius:8px;"></iframe>
        </div>
    </div>

    <script>
        async function fetchDB() { const res = await fetch('/api/db'); return await res.json(); }

        async function renderMsdsList() {
            const keyword = document.getElementById('msdsSearchInput').value.trim().toLowerCase();
            
            const db = await fetchDB();
            let list = db['esol_msds_data'] ? JSON.parse(db['esol_msds_data']) : [];
            
            if (keyword) {
                list = list.filter(m => 
                    m.name.toLowerCase().includes(keyword) || m.cas.toLowerCase().includes(keyword) || 
                    (m.supplier && m.supplier.toLowerCase().includes(keyword)) ||
                    m.tags.some(t => t.toLowerCase().includes(keyword))
                );
            }

            const tbody = document.getElementById('msdsListBody');
            if (list.length === 0) { 
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#999; padding:30px;">검색된 물질이 없습니다.</td></tr>`; return; 
            }
            
            tbody.innerHTML = list.map(m => {
                const tagsHtml = m.tags ? m.tags.map(t => `<span class="tag-badge">⚠️ ${t}</span>`).join('') : '';
                
                // 💡 CAS 번호에 쉼표가 있으면 줄바꿈 처리 (안전한 방식)
                const formattedCas = m.cas ? m.cas.split(' ').join(' <br>') : '-';

                const btnMsds = m.fileUrl ? `<button class="btn-action btn-view" style="margin-bottom:4px; padding:6px 12px;" onclick="previewPdf('${m.fileUrl}', '${m.name} MSDS')">📄 MSDS 보기</button>` : '';
                const btnGuide = m.guideUrl ? `<button class="btn-action" style="background:#ff9800; color:#fff; padding:6px 12px;" onclick="previewPdf('${m.guideUrl}', '${m.name} 공정별 관리요령')">📋 공정별 관리요령 보기</button>` : '';

                return `
                <tr>
                    <td><strong>${m.name}</strong></td>
                    <td>${formattedCas}</td>
                    <td>${m.supplier || '-'}</td>
                    <td>${tagsHtml}</td>
                    <td>
                        <div style="display:flex; gap:8px;">
                            ${btnMsds}
                            ${btnGuide}
                        </div>
                    </td>
                </tr>`
            }).join('');
        }

        function previewPdf(fileUrl, docTitle) {
            document.getElementById('viewingDocTitle').innerText = '📄 ' + docTitle;
            document.getElementById('pdfFrame').src = fileUrl;
            document.getElementById('pdfViewerArea').style.display = 'block';
            setTimeout(() => { window.scrollTo({ top: document.getElementById('pdfViewerArea').offsetTop - 50, behavior: 'smooth' }); }, 100);
        }
        function closeViewer() { 
            document.getElementById('pdfViewerArea').style.display = 'none'; document.getElementById('pdfFrame').src = ''; 
        }

        window.onload = renderMsdsList;
    </script>
</body>
</html>