<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>안전보건 경영방침 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #0277bd; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #0277bd; }
        .back-btn { background: #0277bd; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; border: none; cursor: pointer; transition: 0.2s; }
        .back-btn:hover { opacity: 0.8; }
        .container { max-width: 1600px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-height: 700px; }
        .page-title { font-size: 24px; color: #0277bd; margin-bottom: 20px; border-bottom: 2px solid #0277bd; padding-bottom: 12px; }
        .section-title { font-size: 18px; color: #333; margin-bottom: 15px; font-weight: bold; }
        .btn-download { background: #2e7d32; color: #fff; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: bold; text-decoration: none; display: inline-block; cursor: pointer; border: none; transition: 0.2s; }
        .btn-download:hover { opacity: 0.9; }
        .empty-state { padding: 40px; text-align: center; color: #888; font-size: 15px; background: #f0f8ff; border-radius: 10px; border: 1px dashed #81d4fa; }
        
        /* 💡 돋보기(줌) 버튼 스타일 */
        .zoom-btn { background: #fff; color: #0277bd; border: 1px solid #0277bd; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer; transition: 0.2s; margin-left: 5px; }
        .zoom-btn:hover { background: #0277bd; color: #fff; }
    </style>
</head>
<body>
    <header>
        <div class="brand-title">ESOL <span>안전보건 경영방침</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>
    <div class="container">
        <div class="page-title"><h2 id="policyTitleDisplay">📜 환경안전보건 경영방침</h2></div>
        <p id="policyDescDisplay" style="font-size:14px; color:#666; margin-bottom:30px; line-height:1.6;">최고경영자의 안전보건에 대한 확고한 의지와 회사의 목표를 담은 경영방침입니다. 전 임직원은 본 방침을 숙지하고 이행해주시기 바랍니다.</p>
        
        <div class="section-title">📂 경영방침 개정 이력</div>
        <div id="historyAccordionContainer"></div>
    </div>

    <script>
        async function fetchDB() {
            const res = await fetch('/api/db');
            return await res.json();
        }

        async function renderPolicy() {
            const db = await fetchDB();
            
            // 제목 및 설명 렌더링
            const savedText = db['esol_policy_text'];
            if (savedText) {
                const textInfo = JSON.parse(savedText);
                if (textInfo.title) document.getElementById('policyTitleDisplay').innerText = textInfo.title;
                if (textInfo.desc) document.getElementById('policyDescDisplay').innerText = textInfo.desc;
            }

            // 개정이력 렌더링
            const savedHistory = db['esol_policy_history'];
            const historyList = savedHistory ? JSON.parse(savedHistory) : [];
            const container = document.getElementById('historyAccordionContainer');

            if (historyList.length === 0) {
                container.innerHTML = `<div class="empty-state">등록된 경영방침이 없습니다. 관리자 페이지에서 등록해주세요.</div>`; 
                return;
            }

            container.innerHTML = historyList.map((m, index) => {
                const isExpanded = (index === 0);
                
                // 💡 [핵심 변경] 어두운 뷰어 배경과 확대/축소 버튼 및 영역 추가!
                let previewHtml = `
                    <div style="display:flex; justify-content:flex-end; align-items:center; margin-top:15px; margin-bottom:10px;">
                        <span style="font-size:13px; color:#666; margin-right:10px;">🔍 뷰어 크기 조절:</span>
                        <button class="zoom-btn" onclick="adjustZoom('${m.id}', 'out')">➖ 축소</button>
                        <button class="zoom-btn" onclick="adjustZoom('${m.id}', 'reset')">🔄 원래크기</button>
                        <button class="zoom-btn" onclick="adjustZoom('${m.id}', 'in')">➕ 확대</button>
                    </div>
                    <div style="width:100%; height:75vh; overflow:auto; background:#525659; border-radius:8px; text-align:center; padding:20px; box-sizing:border-box; border:1px solid #ccc;">
                `;

                if (m.type === 'pdf') { 
                    // PDF 뷰어
                    previewHtml += `<iframe id="content-${m.id}" src="${m.fileUrl}" style="width:70%; height:1000px; border:none; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.5); transition:width 0.3s ease, height 0.3s ease;"></iframe>`; 
                } else { 
                    // 이미지 뷰어
                    previewHtml += `<img id="content-${m.id}" src="${m.fileUrl}" style="width:70%; max-width:none; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.5); transition:width 0.3s ease;">`; 
                }
                
                previewHtml += `</div>`;
                
                return `
                    <div style="margin-bottom:12px; border:1px solid #eae2f0; border-radius:8px; overflow:hidden; background:#fff;">
                        <div style="background:${isExpanded ? '#e1f5fe' : '#ffffff'}; padding:16px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.2s;" onclick="toggleHistory('${m.id}')">
                            <div style="display:flex; align-items:center; gap:15px; flex:1;">
                                <span style="background:${isExpanded ? '#e53935' : '#0277bd'}; color:#fff; font-size:12px; font-weight:bold; padding:4px 8px; border-radius:6px;">${isExpanded ? '최신본' : '과거이력'}</span>
                                <h4 style="margin:0; color:#222; font-size:16px; flex:1;">${m.title}</h4>
                                <span style="color:#666; font-size:13px; margin-right:20px;">📅 개정 일자: ${m.date}</span>
                            </div>
                            <span id="icon-${m.id}" style="color:#888; font-size:13px; font-weight:bold;">${isExpanded ? '▲ 접기' : '▼ 펼쳐보기'}</span>
                        </div>
                        <div id="body-${m.id}" style="display:${isExpanded ? 'block' : 'none'}; padding:20px; border-top:1px solid #eae2f0;">
                            <div style="display:flex; justify-content: space-between; align-items: center; background:#f4f5f9; padding:10px 15px; border-radius:8px;">
                                <span style="font-weight:bold; color:#0277bd; font-size: 14px;">📎 ${m.fileName}</span>
                                <a href="${m.fileUrl}" download="${m.fileName}" class="btn-download">💾 원본 파일 다운로드</a>
                            </div>
                            ${previewHtml}
                        </div>
                    </div>`;
            }).join('');
        }

        function toggleHistory(id) {
            const bodyDiv = document.getElementById(`body-${id}`);
            const iconSpan = document.getElementById(`icon-${id}`);
            if (bodyDiv.style.display === 'none') {
                bodyDiv.style.display = 'block'; iconSpan.innerText = '▲ 접기'; iconSpan.parentElement.style.background = '#e1f5fe';
            } else {
                bodyDiv.style.display = 'none'; iconSpan.innerText = '▼ 펼쳐보기'; iconSpan.parentElement.style.background = '#ffffff';
            }
        }

        // 💡 [핵심 기능] 줌(Zoom) 제어 함수
        window.zoomLevels = {}; // 각 문서별 줌 상태 저장
        
        window.adjustZoom = function(id, action) {
            if (!window.zoomLevels[id]) window.zoomLevels[id] = 70; // 기본 크기 70%

            if (action === 'in') {
                window.zoomLevels[id] += 15; // 15%씩 확대
            } else if (action === 'out') {
                window.zoomLevels[id] -= 15; // 15%씩 축소
            } else {
                window.zoomLevels[id] = 70;  // 원래 크기로 리셋
            }

            // 너무 작아지거나 너무 커지지 않도록 한계치 설정 (30% ~ 250%)
            if (window.zoomLevels[id] < 30) window.zoomLevels[id] = 30;
            if (window.zoomLevels[id] > 250) window.zoomLevels[id] = 250;

            const targetEl = document.getElementById(`content-${id}`);
            if (targetEl) {
                targetEl.style.width = window.zoomLevels[id] + '%';
                // PDF인 경우 가로가 넓어지면 세로도 비율에 맞게 길어지도록 설정
                if (targetEl.tagName === 'IFRAME') {
                    targetEl.style.height = (window.zoomLevels[id] * 15) + 'px'; 
                }
            }
        };

        window.onload = renderPolicy;
    </script>
</body>
</html>