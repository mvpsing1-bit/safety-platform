<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>산업안전보건위원회 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #4a0082; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #4a0082; }
        .brand-title span { color: #b0268d; }
        .back-btn { background: #4a0082; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; }

        .container { max-width: 1600px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-height: 700px; }
        .page-title { font-size: 24px; color: #4a0082; margin-bottom: 30px; border-bottom: 2px solid #4a0082; padding-bottom: 12px; }

        .notice-card { background: linear-gradient(135deg, #f0e6f6, #fff); border: 2px solid #b0268d; border-radius: 16px; padding: 24px; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(176,38,141,0.1); position: relative; overflow: hidden; }
        .notice-card::before { content: 'D-DAY'; position: absolute; top: 20px; right: -30px; background: #b0268d; color: #fff; padding: 5px 40px; font-weight: bold; transform: rotate(45deg); font-size: 12px; }
        .notice-card h3 { color: #b0268d; font-size: 20px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .notice-info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; background: #fff; padding: 16px; border-radius: 10px; border: 1px solid #eae2f0; }
        
        .info-item { font-size: 15px; display: flex; gap: 10px; align-items: flex-start; }
        .info-item strong { color: #4a0082; display: inline-block; white-space: nowrap; flex-shrink: 0; min-width: 75px; }

        .section-title { font-size: 18px; color: #333; margin-bottom: 15px; font-weight: bold; display: flex; align-items: center; gap: 8px; }

        .empty-state { padding: 40px; text-align: center; color: #888; font-size: 15px; background: #f9f9f9; border-radius: 10px; border: 1px dashed #ccc; }
    </style>
</head>
<body>

    <header>
        <div class="brand-title">ESOL <span>환경안전보건 플랫폼</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>

    <div class="container">
        <div class="page-title">
            <h2>🤝 산업안전보건위원회</h2>
        </div>

        <div id="upcomingNoticeArea"></div>

        <div class="section-title">📂 회의록 및 안건 자료실</div>
        <div id="minutesAccordionContainer"></div>
    </div>

    <script>
        async function renderCommitteePage() {
            const res = await fetch('/api/db');
            const db = await res.json();

            // 공지 렌더링
            const savedNotice = db['esol_committee_notice'];
            const noticeArea = document.getElementById('upcomingNoticeArea');
            if (savedNotice) {
                const notice = JSON.parse(savedNotice);
                if (notice.isActive) {
                    noticeArea.innerHTML = `
                        <div class="notice-card">
                            <h3>📢 다음 위원회 개최 안내</h3>
                            <div style="margin-bottom:15px; font-size:15px; font-weight:bold; color:#333;">${notice.title}</div>
                            <div class="notice-info-grid">
                                <div class="info-item"><strong>📅 일시</strong> <span>${notice.date} ${notice.time}</span></div>
                                <div class="info-item"><strong>📍 장소</strong> <span>${notice.location}</span></div>
                                <div class="info-item" style="grid-column: 1 / 3;"><strong>👥 참석 대상</strong> <span>${notice.attendees}</span></div>
                            </div>
                        </div>
                    `;
                } else { noticeArea.innerHTML = ''; }
            } else { noticeArea.innerHTML = ''; }

            // 회의록 및 안건 렌더링
            const savedMinutes = db['esol_committee_minutes'];
            const minutesList = savedMinutes ? JSON.parse(savedMinutes) : [];
            const accordionContainer = document.getElementById('minutesAccordionContainer');

            if (minutesList.length === 0) {
                accordionContainer.innerHTML = `<div class="empty-state">등록된 회의록이 없습니다.</div>`; return;
            }

            accordionContainer.innerHTML = minutesList.map((m, index) => {
                const num = minutesList.length - index;
                const isExpanded = (index === 0); 
                let fileContent = '<span style="color:#aaa;">첨부된 파일이 없습니다.</span>';
                
                const filesArray = m.files ? m.files : (m.fileUrl ? [{ fileName: m.fileName, fileUrl: m.fileUrl }] : []);
                if (filesArray.length > 0) {
                    fileContent = filesArray.map(f => {
                        const isPdf = f.fileName.toLowerCase().endsWith('.pdf');
                        const isImage = f.fileName.toLowerCase().match(/\.(jpg|jpeg|png|gif)$/i);
                        let previewHtml = '';
                        if (isPdf) { previewHtml = `<iframe src="${f.fileUrl}" width="100%" height="650px" style="border: 1px solid #ccc; border-radius: 8px; margin-top: 10px;"></iframe>`; }
                        else if (isImage) { previewHtml = `<img src="${f.fileUrl}" style="max-width: 100%; border: 1px solid #ccc; border-radius: 8px; margin-top: 10px;">`; }
                        return `<div style="margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px dashed #ddd;"><div style="background:#f4f5f9; padding:10px 15px; border-radius:8px;"><span style="font-weight:bold; color:#4a0082; font-size: 14px;">📎 첨부: ${f.fileName}</span></div>${previewHtml}</div>`;
                    }).join('');
                }

                return `
                    <div style="margin-bottom:12px; border:1px solid #eae2f0; border-radius:8px; overflow:hidden; background:#fff; box-shadow: 0 2px 5px rgba(0,0,0,0.02);">
                        <div style="background:${isExpanded ? '#f8f5fc' : '#ffffff'}; padding:16px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.2s;" onclick="toggleMinute('${m.id}')">
                            <div style="display:flex; align-items:center; gap:15px; flex:1;">
                                <span style="background:#4a0082; color:#fff; font-size:12px; font-weight:bold; padding:4px 8px; border-radius:6px;">No.${num}</span>
                                <h4 style="margin:0; color:#222; font-size:16px; flex:1;">${m.title}</h4>
                                <span style="color:#666; font-size:13px; margin-right:20px;">📅 개최 일자: ${m.date}</span>
                            </div>
                            <span id="icon-${m.id}" style="color:#888; font-size:13px; font-weight:bold;">${isExpanded ? '▲ 접기' : '▼ 펼쳐보기'}</span>
                        </div>
                        <div id="body-${m.id}" style="display:${isExpanded ? 'block' : 'none'}; padding:20px; border-top:1px solid #eae2f0;">
                            ${fileContent}
                        </div>
                    </div>`;
            }).join('');
        }

        function toggleMinute(id) {
            const bodyDiv = document.getElementById(`body-${id}`);
            const iconSpan = document.getElementById(`icon-${id}`);
            if (bodyDiv.style.display === 'none') {
                bodyDiv.style.display = 'block'; iconSpan.innerText = '▲ 접기'; iconSpan.parentElement.style.background = '#f8f5fc';
            } else {
                bodyDiv.style.display = 'none'; iconSpan.innerText = '▼ 펼쳐보기'; iconSpan.parentElement.style.background = '#ffffff';
            }
        }
        window.onload = renderCommitteePage;
    </script>
</body>
</html>