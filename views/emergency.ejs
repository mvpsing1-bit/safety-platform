<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>비상대응 매뉴얼 - ESOL 환경안전보건 플랫폼</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f5f9; color: #333; padding: 24px; }
        header { display: flex; justify-content: space-between; align-items: center; background: #ffffff; padding: 20px 32px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border-left: 8px solid #d32f2f; margin-bottom: 24px; }
        .brand-title { font-size: 26px; font-weight: 900; color: #d32f2f; }
        .back-btn { background: #d32f2f; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; border: none; cursor: pointer; transition: 0.2s; }
        .back-btn:hover { opacity: 0.8; }
        .container { max-width: 1600px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-height: 700px; }
        .page-title { font-size: 24px; color: #d32f2f; margin-bottom: 20px; border-bottom: 2px solid #d32f2f; padding-bottom: 12px; }
        .section-title { font-size: 18px; color: #333; margin-bottom: 15px; font-weight: bold; }
        .btn-download { background: #2e7d32; color: #fff; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: bold; text-decoration: none; display: inline-block; cursor: pointer; border: none; transition: 0.2s; }
        .btn-download:hover { opacity: 0.9; }
        .empty-state { padding: 40px; text-align: center; color: #888; font-size: 15px; background: #ffebee; border-radius: 10px; border: 1px dashed #ef9a9a; }
        
    </style>
</head>
<body>
    <header>
        <div class="brand-title">ESOL <span>비상대응 매뉴얼</span></div>
        <a href="/" class="back-btn">🏠 메인 화면으로 돌아가기</a>
    </header>
    <div class="container">
        <div class="page-title"><h2 id="emgTitleDisplay">🚨 비상대응 매뉴얼</h2></div>
        <p id="emgDescDisplay" style="font-size:14px; color:#666; margin-bottom:30px; line-height:1.6;">사업장 내 화재, 폭발, 화학물질 누출 등 중대산업사고 발생 시 신속하고 정확한 대응을 위한 비상대응 시나리오 및 행동요령입니다.</p>
        
        <div class="section-title">📂 매뉴얼 게시 및 개정 이력</div>
        <div id="historyAccordionContainer"></div>
    </div>

    <script>
        async function fetchDB() {
            const res = await fetch('/api/db');
            return await res.json();
        }

        async function renderEmergency() {
            const db = await fetchDB();
            
            // 제목 및 안내 문구 렌더링
            const savedText = db['esol_emergency_text'];
            if (savedText) {
                const textInfo = JSON.parse(savedText);
                if (textInfo.title) document.getElementById('emgTitleDisplay').innerText = textInfo.title;
                if (textInfo.desc) document.getElementById('emgDescDisplay').innerText = textInfo.desc;
            }

            // 매뉴얼 개정이력 렌더링
            const savedHistory = db['esol_emergency_history'];
            const historyList = savedHistory ? JSON.parse(savedHistory) : [];
            const container = document.getElementById('historyAccordionContainer');

            if (historyList.length === 0) {
                container.innerHTML = `<div class="empty-state">등록된 비상대응 매뉴얼이 없습니다. 관리자 페이지에서 등록해주세요.</div>`; 
                return;
            }

            container.innerHTML = historyList.map((m, index) => {
                const isExpanded = (index === 0);
                
                // 💡 어두운 뷰어 배경 및 확대/축소 영역 적용
                let previewHtml = `
                    <div style="width:100%; height:75vh; overflow:auto; background:#525659; border-radius:8px; text-align:center; padding:20px; box-sizing:border-box; border:1px solid #ccc;">
                `;

                // 🚨 핵심 수정: src 대신 data-src 사용! (브라우저가 뻗는 것을 방지)
                if (m.type === 'pdf') { 
                    previewHtml += `<iframe id="content-${m.id}" data-src="${m.fileUrl}" style="width:100%; height:100%; border:none; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.5); transition:width 0.3s ease, height 0.3s ease;"></iframe>`; 
                } else { 
                    previewHtml += `<img id="content-${m.id}" src="${m.fileUrl}" style="width:100%; max-width:none; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.5); transition:width 0.3s ease;">`; 
                }
                
                previewHtml += `</div>`;
                
                return `
                    <div style="margin-bottom:12px; border:1px solid #eae2f0; border-radius:8px; overflow:hidden; background:#fff;">
                        <div style="background:${isExpanded ? '#ffebee' : '#ffffff'}; padding:16px 20px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; transition:background 0.2s;" onclick="toggleHistory('${m.id}')">
                            <div style="display:flex; align-items:center; gap:15px; flex:1;">
                                <span style="background:${isExpanded ? '#c62828' : '#d32f2f'}; color:#fff; font-size:12px; font-weight:bold; padding:4px 8px; border-radius:6px;">${isExpanded ? '최신본' : '과거이력'}</span>
                                <h4 style="margin:0; color:#222; font-size:16px; flex:1;">${m.title}</h4>
                                <span style="color:#666; font-size:13px; margin-right:20px;">📅 개정 일자: ${m.date}</span>
                            </div>
                            <span id="icon-${m.id}" style="color:#888; font-size:13px; font-weight:bold;">${isExpanded ? '▲ 접기' : '▼ 펼쳐보기'}</span>
                        </div>
                        <div id="body-${m.id}" style="display:${isExpanded ? 'block' : 'none'}; padding:20px; border-top:1px solid #eae2f0;">
                            <div style="display:flex; justify-content: space-between; align-items: center; background:#f4f5f9; padding:10px 15px; border-radius:8px; margin-bottom: 10px;">
                                <span style="font-weight:bold; color:#d32f2f; font-size: 14px;">📎 ${m.fileName}</span>
                            </div>
                            ${previewHtml}
                        </div>
                    </div>`;
            }).join('');

            // 🚨 핵심 수정: 크롬/엣지에서 대용량 PDF도 안 깨지게 만드는 가상 파일(Blob) 변환 로직!
            document.querySelectorAll('iframe[data-src]').forEach(iframe => {
                const base64Data = iframe.getAttribute('data-src');
                if (base64Data && base64Data.startsWith('data:application/pdf')) {
                    try {
                        const arr = base64Data.split(',');
                        const bstr = atob(arr[1]);
                        let n = bstr.length;
                        const u8arr = new Uint8Array(n);
                        while(n--) { u8arr[n] = bstr.charCodeAt(n); }
                        const blob = new Blob([u8arr], {type: 'application/pdf'});
                        iframe.src = URL.createObjectURL(blob);
                    } catch (e) {
                        iframe.src = base64Data;
                    }
                } else {
                    iframe.src = base64Data;
                }
            });
        }

        function toggleHistory(id) {
            const bodyDiv = document.getElementById(`body-${id}`);
            const iconSpan = document.getElementById(`icon-${id}`);
            if (bodyDiv.style.display === 'none') {
                bodyDiv.style.display = 'block'; iconSpan.innerText = '▲ 접기'; iconSpan.parentElement.style.background = '#ffebee';
            } else {
                bodyDiv.style.display = 'none'; iconSpan.innerText = '▼ 펼쳐보기'; iconSpan.parentElement.style.background = '#ffffff';
            }
        }


        window.onload = renderEmergency;
    </script>
</body>
</html>