    <script src="/js/admin.js"></script>
    <script>
        // 💡 [DB 통신 유틸 함수]
        async function fetchDB() {
            const res = await fetch('/api/db');
            return await res.json();
        }
        async function saveDB(key, value) {
            await fetch('/api/db', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key, value: value ? JSON.stringify(value) : null })
            });
        }

        const readAsDataURL = (file) => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve(e.target.result);
            reader.onerror = (e) => reject(e);
            reader.readAsDataURL(file);
        });

        // ==========================================
        // 1. 조직도 개정이력 DB 연동
        // ==========================================
        async function renderAdminOrgTable() {
            const db = await fetchDB();
            const list = db['esol_org_history'] ? JSON.parse(db['esol_org_history']) : [];
            const tbody = document.getElementById('adminOrgHistoryBody');
            if (list.length === 0) return tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:15px; color:#888;">등록된 조직도 개정이력이 없습니다.</td></tr>`;
            tbody.innerHTML = list.map(m => `<tr><td style="font-weight:bold;">${m.title}</td><td>${m.date}</td><td style="color:#1976d2; font-size:12px;">${m.fileName}</td><td style="text-align:center;"><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deleteOrgRevision('${m.id}')">삭제</button></td></tr>`).join('');
        }
        async function uploadOrgRevision() {
            const title = document.getElementById('orgRevTitle').value.trim();
            const date = document.getElementById('orgRevDate').value;
            const fileInput = document.getElementById('orgRevFile');
            if (!title || !date || !fileInput.files.length) return alert('모든 정보를 입력 및 첨부해주세요.');
            const file = fileInput.files[0];
            try {
                const base64Data = await readAsDataURL(file);
                const db = await fetchDB();
                const list = db['esol_org_history'] ? JSON.parse(db['esol_org_history']) : [];
                list.unshift({ id: Date.now().toString(), title, date, fileName: file.name, fileUrl: base64Data, type: file.name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image' });
                await saveDB('esol_org_history', list);
                alert('✅ 등록되었습니다.');
                document.getElementById('orgRevTitle').value = ''; document.getElementById('orgRevDate').value = ''; fileInput.value = ''; renderAdminOrgTable();
            } catch (err) { alert('업로드 에러 발생'); }
        }
        async function deleteOrgRevision(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_org_history'] ? JSON.parse(db['esol_org_history']) : [];
            list = list.filter(m => m.id !== id); 
            await saveDB('esol_org_history', list); renderAdminOrgTable();
        }

        // ==========================================
        // 2. 비상대응 매뉴얼 개정이력 DB 연동
        // ==========================================
        async function renderAdminEmergency() {
            const db = await fetchDB();
            const savedText = db['esol_emergency_text'];
            if (savedText) {
                const textInfo = JSON.parse(savedText);
                document.getElementById('emgTitleInput').value = textInfo.title || ''; document.getElementById('emgDescInput').value = textInfo.desc || '';
            }
            const list = db['esol_emergency_history'] ? JSON.parse(db['esol_emergency_history']) : [];
            const tbody = document.getElementById('adminEmgHistoryBody');
            if (list.length === 0) return tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:15px; color:#888;">등록된 매뉴얼 이력이 없습니다.</td></tr>`;
            tbody.innerHTML = list.map(m => `<tr><td style="font-weight:bold;">${m.title}</td><td>${m.date}</td><td style="color:#1976d2; font-size:12px;">${m.fileName}</td><td style="text-align:center;"><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deleteEmgRevision('${m.id}')">삭제</button></td></tr>`).join('');
        }
        async function saveEmergencyText() {
            const title = document.getElementById('emgTitleInput').value.trim();
            const desc = document.getElementById('emgDescInput').value.trim();
            await saveDB('esol_emergency_text', { title, desc }); alert('저장 완료');
        }
        async function uploadEmgRevision() {
            const title = document.getElementById('emgRevTitle').value.trim();
            const date = document.getElementById('emgRevDate').value;
            const fileInput = document.getElementById('emgRevFile');
            if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.');
            const file = fileInput.files[0];
            try {
                const base64Data = await readAsDataURL(file);
                const db = await fetchDB();
                const list = db['esol_emergency_history'] ? JSON.parse(db['esol_emergency_history']) : [];
                list.unshift({ id: Date.now().toString(), title, date, fileName: file.name, fileUrl: base64Data, type: file.name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image' });
                await saveDB('esol_emergency_history', list); alert('✅ 등록 완료');
                document.getElementById('emgRevTitle').value = ''; document.getElementById('emgRevDate').value = ''; fileInput.value = ''; renderAdminEmergency();
            } catch (err) { alert('업로드 에러 발생'); }
        }
        async function deleteEmgRevision(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_emergency_history'] ? JSON.parse(db['esol_emergency_history']) : [];
            list = list.filter(m => m.id !== id); await saveDB('esol_emergency_history', list); renderAdminEmergency();
        }

