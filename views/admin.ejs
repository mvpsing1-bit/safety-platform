        async function uploadPolicyRevision() { const title = document.getElementById('policyRevTitle').value.trim(); const date = document.getElementById('policyRevDate').value; const fileInput = document.getElementById('policyRevFile'); if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.'); try { const base64Data = await readAsDataURL(fileInput.files[0]); const db = await fetchDB(); const list = db['esol_policy_history'] ? JSON.parse(db['esol_policy_history']) : []; list.unshift({ id: Date.now().toString(), title, date, fileName: fileInput.files[0].name, fileUrl: base64Data, type: fileInput.files[0].name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image' }); await saveDB('esol_policy_history', list); alert('✅ 등록 완료'); document.getElementById('policyRevTitle').value = ''; document.getElementById('policyRevDate').value = ''; fileInput.value = ''; renderAdminPolicy(); } catch (err) { alert('에러 발생'); } }
        async function deletePolicyRevision(id) { if (!confirm('삭제하시겠습니까?')) return; const db = await fetchDB(); let list = db['esol_policy_history'] ? JSON.parse(db['esol_policy_history']) : []; list = list.filter(m => m.id !== id); await saveDB('esol_policy_history', list); renderAdminPolicy(); }

