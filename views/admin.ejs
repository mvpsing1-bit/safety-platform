            const title = document.getElementById('cntRevTitle').value.trim();
            const date = document.getElementById('cntRevDate').value;
            const fileInput = document.getElementById('cntRevFile');
            if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.');
            const file = fileInput.files[0];
            try {
                const base64Data = await readAsDataURL(file);
                const db = await fetchDB();
