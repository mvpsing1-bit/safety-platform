        async function saveLawText() { const title = document.getElementById('lawTitleInput').value.trim(); const desc = document.getElementById('lawDescInput').value.trim(); await saveDB('esol_law_text', { title, desc }); alert('저장 완료'); }
        async function uploadLawRevision() { const title = document.getElementById('lawRevTitle').value.trim(); const date = document.getElementById('lawRevDate').value; const fileInput = document.getElementById('lawRevFile'); if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.'); try { const base64Data = await readAsDataURL(fileInput.files[0]); const db = await fetchDB(); const list = db['esol_law_history'] ? JSON.parse(db['esol_law_history']) : []; list.unshift({ id: Date.now().toString(), title, date, fileName: fileInput.files[0].name, fileUrl: base64Data, type: fileInput.files[0].name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image' }); await saveDB('esol_law_history', list); alert('✅ 등록 완료'); document.getElementById('lawRevTitle').value = ''; document.getElementById('lawRevDate').value = ''; fileInput.value = ''; renderAdminLaw(); } catch (err) { alert('에러 발생'); } }
        async function deleteLawRevision(id) { if (!confirm('삭제하시겠습니까?')) return; const db = await fetchDB(); let list = db['esol_law_history'] ? JSON.parse(db['esol_law_history']) : []; list = list.filter(m => m.id !== id); await saveDB('esol_law_history', list); renderAdminLaw(); }

        const originalLoadAdminMenuList = window.loadAdminMenuList;
        window.loadAdminMenuList = async function() {
            if (typeof originalLoadAdminMenuList === 'function') await originalLoadAdminMenuList();
            await renderDynamicSidebar();
        };

        // 💡 [특수건강검진] 자동 계산 및 리스트 출력 로직 (소견 추가)
        async function loadAdminHealthData() {
            const db = await fetchDB();
            const list = db['esol_special_health'] ? JSON.parse(db['esol_special_health']) : [];
            const tbody = document.getElementById('adminHealthListBody');
            if(!tbody) return;

            const searchEl = document.getElementById('spHealthSearch');
            const keyword = searchEl ? searchEl.value.trim().toLowerCase() : '';
            const filteredList = list.filter(h => h.empNo.toLowerCase().includes(keyword) || h.name.toLowerCase().includes(keyword) || h.hazard.toLowerCase().includes(keyword));

            if (filteredList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:15px; color:#888;">등록된 특수검진 대상자가 없습니다.</td></tr>`;
                return;
            }
            
            tbody.innerHTML = filteredList.map(h => {
                let dueDateStr = '-';
                let dueColor = '#333';
                let checkupLabel = '';
                let baseDate = null;
                
                if (h.lastDate) {
                    baseDate = new Date(h.lastDate);
                    baseDate.setFullYear(baseDate.getFullYear() + 1);
                    checkupLabel = '정기';
                } else if (h.firstDate) {
                    baseDate = new Date(h.firstDate);
                    baseDate.setMonth(baseDate.getMonth() + 6);
                    checkupLabel = '배치후';
                }

                if(baseDate) {
                    dueDateStr = baseDate.getFullYear() + '-' + String(baseDate.getMonth() + 1).padStart(2, '0') + '-' + String(baseDate.getDate()).padStart(2, '0');
                    const diffDays = (baseDate - new Date()) / (1000 * 60 * 60 * 24);
                    if (diffDays <= 30) dueColor = '#d32f2f'; 
                    dueDateStr += `<br><span style="font-size:11px; color:#888; background:#eee; padding:2px 6px; border-radius:4px; margin-top:4px; display:inline-block;">${checkupLabel}</span>`;
                }

                const counselBadge = h.counseling === '대상' ? '<span style="color:#d32f2f; font-weight:bold;">대상</span>' : '<span style="color:#888;">-</span>';

                return `
                <tr>
                    <td>${h.empNo}</td>
                    <td style="font-weight:bold;">${h.name}</td>
                    <td style="color:#b0268d;">${h.hazard}</td>
                    <td>${h.firstDate || '-'}</td>
                    <td>${h.lastDate || '-'}</td>
                    <td style="font-weight:bold; color:${dueColor}; line-height:1.4;">${dueDateStr}</td>
                    <td style="text-align:center;">${counselBadge}</td>
                    <td style="text-align:center;">
                        <button class="submit-btn" style="background:#ff9800; padding:4px 8px; font-size:12px;" onclick="editSpecialHealth('${h.id}')">수정</button>
                        <button class="submit-btn" style="background:#e53935; padding:4px 8px; font-size:12px;" onclick="deleteSpecialHealth('${h.id}')">삭제</button>
                    </td>
                </tr>`;
            }).join('');
        }

        async function saveSpecialHealth() {
            const editId = document.getElementById('editSpHealthId').value;
            const empNo = document.getElementById('spEmpNo').value.trim();
            const name = document.getElementById('spName').value.trim();
            const hazard = document.getElementById('spHazard').value.trim();
            
            const checkupResult = document.getElementById('spCheckupResult').value.trim();
            const followUp = document.getElementById('spFollowUp').value.trim();
            const counseling = document.getElementById('spCounseling').value;

            const firstDate = document.getElementById('spFirstDate').value;
            const lastDate = document.getElementById('spLastDate').value;

            if (!empNo || !name || !hazard || !firstDate) return alert('사번, 이름, 유해인자, 최초 검진일은 필수 입력 사항입니다.');

            const db = await fetchDB();
            let list = db['esol_special_health'] ? JSON.parse(db['esol_special_health']) : [];

            if (editId) {
                const idx = list.findIndex(h => h.id === editId);
                if (idx !== -1) {
                    list[idx].empNo = empNo; list[idx].name = name; list[idx].hazard = hazard;
                    list[idx].checkupResult = checkupResult; list[idx].followUp = followUp; list[idx].counseling = counseling;
                    list[idx].firstDate = firstDate; list[idx].lastDate = lastDate;
                }
            } else {
                list.unshift({ id: Date.now().toString(), empNo, name, hazard, checkupResult, followUp, counseling, firstDate, lastDate });
            }

            await saveDB('esol_special_health', list);
            cancelSpHealthEdit();
            loadAdminHealthData();
            alert('저장되었습니다.');
        }

        async function editSpecialHealth(id) {
            const db = await fetchDB();
            const list = db['esol_special_health'] ? JSON.parse(db['esol_special_health']) : [];
            const h = list.find(x => x.id === id);
            if(!h) return;

            document.getElementById('editSpHealthId').value = h.id;
            document.getElementById('spEmpNo').value = h.empNo;
            document.getElementById('spName').value = h.name;
            document.getElementById('spHazard').value = h.hazard;
            
            document.getElementById('spCheckupResult').value = h.checkupResult || '';
            document.getElementById('spFollowUp').value = h.followUp || '';
            document.getElementById('spCounseling').value = h.counseling || '-';

            document.getElementById('spFirstDate').value = h.firstDate || '';
            document.getElementById('spLastDate').value = h.lastDate || '';

            document.getElementById('spHealthFormTitle').innerText = '✏️ 특수검진 정보 수정 (검진일 갱신 및 소견 추가)';
            document.getElementById('spHealthSubmitBtn').innerText = '수정 저장';
            document.getElementById('spHealthCancelBtn').style.display = 'inline-block';
        }

        function cancelSpHealthEdit() {
            document.getElementById('editSpHealthId').value = '';
            document.getElementById('spEmpNo').value = ''; document.getElementById('spName').value = '';
            document.getElementById('spHazard').value = ''; 
            
            document.getElementById('spCheckupResult').value = '';
            document.getElementById('spFollowUp').value = '';
            document.getElementById('spCounseling').value = '-';

            document.getElementById('spFirstDate').value = ''; document.getElementById('spLastDate').value = '';
            
            document.getElementById('spHealthFormTitle').innerText = '➕ 신규 특수검진 대상자 등록';
            document.getElementById('spHealthSubmitBtn').innerText = '+ 정보 저장';
            document.getElementById('spHealthCancelBtn').style.display = 'none';
        }

        async function deleteSpecialHealth(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_special_health'] ? JSON.parse(db['esol_special_health']) : [];
            list = list.filter(h => h.id !== id);
            await saveDB('esol_special_health', list);
            loadAdminHealthData();
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderDynamicSidebar();
            if (document.getElementById('tab4') && document.getElementById('tab4').classList.contains('active')) loadAdminUserList();
            if (document.getElementById('tab3') && document.getElementById('tab3').classList.contains('active')) loadAdminPpeManagement();
            if (document.getElementById('tab8') && document.getElementById('tab8').classList.contains('active')) renderAdminOrgTable();
            if (document.getElementById('tab9') && document.getElementById('tab9').classList.contains('active')) renderAdminCommittee();
            if (document.getElementById('tab10') && document.getElementById('tab10').classList.contains('active')) renderAdminEmergency();
            if (document.getElementById('tab11') && document.getElementById('tab11').classList.contains('active')) renderAdminContact();
            if (document.getElementById('tab12') && document.getElementById('tab12').classList.contains('active')) renderAdminPolicy();
            if (document.getElementById('tab13') && document.getElementById('tab13').classList.contains('active')) renderAdminLaw();
            if (document.getElementById('tab14') && document.getElementById('tab14').classList.contains('active')) renderAdminRisk();
            // 💡 추가: 탭 16 활성화 시 데이터 로드
            if (document.getElementById('tab16') && document.getElementById('tab16').classList.contains('active')) loadAdminHealthData();
        });
    </script>
