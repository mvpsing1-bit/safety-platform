<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>ESOL 환경안전보건 플랫폼 - 관리자 시스템</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="login-overlay" id="loginModal">
        <div class="login-box">
            <h2>⚙️ 관리자 인증</h2>
            <p style="font-size: 13px; color: #666; margin-bottom: 15px;">관리자 전용 비밀번호를 입력하세요.</p>
            <input type="password" id="adminPw" placeholder="비밀번호 입력 (초기: 1234)" onkeypress="if(event.key==='Enter') checkPassword()">
            <button onclick="checkPassword()">로그인</button>
        </div>
    </div>

    <header>
        <h1>⚙️ ESOL 환경안전보건 플랫폼 관리자 시스템</h1>
        <a href="/" class="back-btn">🖥️ 메인 화면으로 돌아가기</a>
    </header>

    <!-- 💡 DRI 수정 팝업창 -->
    <div class="custom-modal-overlay" id="driEditModal">
        <div class="custom-modal" style="max-width: 600px;">
            <h3 style="color:#4a0082; border-bottom:2px solid #eae2f0; padding-bottom:10px; margin-bottom:20px;">📝 DRI 내용 수정</h3>
            <input type="hidden" id="editDriId">
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:15px;">
                <div><label style="font-size:12px; font-weight:bold;">날짜</label><input type="date" id="editDriDate" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></div>
                <div><label style="font-size:12px; font-weight:bold;">부서</label><select id="editDriDeptSelect" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></select></div>
            </div>
            
            <div style="margin-bottom:15px;">
                <label style="font-size:12px; font-weight:bold;">작업시간</label>
                <div style="display:flex; gap:10px; align-items:center;">
                    <input type="time" id="editDriStartTime" style="flex:1; padding:8px; border:1px solid #ccc; border-radius:6px;">
                    <span>~</span>
                    <input type="time" id="editDriEndTime" style="flex:1; padding:8px; border:1px solid #ccc; border-radius:6px;">
                </div>
            </div>

            <div style="margin-bottom:15px;"><label style="font-size:12px; font-weight:bold;">장소(설비)</label><input type="text" id="editDriLocation" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></div>
            <div style="margin-bottom:15px;"><label style="font-size:12px; font-weight:bold;">작업 내용</label><textarea id="editDriTask" rows="2" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></textarea></div>
            <div style="margin-bottom:15px;"><label style="font-size:12px; font-weight:bold;">위험 요소</label><textarea id="editDriRisk" rows="2" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></textarea></div>
            <div style="margin-bottom:20px;"><label style="font-size:12px; font-weight:bold;">안전 대책</label><textarea id="editDriMeasure" rows="2" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:6px;"></textarea></div>
            
            <div style="display:flex; gap:10px;">
                <button class="submit-btn" style="flex:1; background:#888;" onclick="document.getElementById('driEditModal').style.display='none'">취소</button>
                <button class="submit-btn" style="flex:1; background:#4a0082;" onclick="saveDriEdit()">수정 저장</button>
            </div>
        </div>
    </div>

    <div class="admin-wrapper">
        
        <!-- 동적 사이드바 -->
        <aside class="sidebar" id="dynamicSidebar">
            <div class="nav-group">
                <div class="nav-title" onclick="toggleNav('nav-system')">
                    ⚙️ 시스템 및 운영 관리 <span class="arrow">▼</span>
                </div>
                <div class="nav-items" id="nav-system">
                    <button class="nav-item active" onclick="switchPanel('tab1', this)">🛠️ 현황판 메뉴 관리</button>
                    <button class="nav-item" onclick="switchPanel('tab5', this)">📢 공지사항 관리</button>
                    <button class="nav-item" onclick="switchPanel('tab4', this)">👤 구성원 계정 관리</button>
                    <button class="nav-item" onclick="switchPanel('tab2', this)">✏️ 시스템 일반 설정</button>
                </div>
            </div>
            <div id="dynamicNavGroups"></div>
        </aside>

        <!-- 👉 우측 메인 콘텐츠 영역 -->
        <main class="main-content">
            
            <!-- 탭1: 메뉴 관리 -->
            <div id="tab1" class="panel active">
                <h2>🛠️ 메뉴 이름/설명 수정, 순서 변경 및 신규 추가/삭제</h2>
                <div class="form-group" style="background:#f8f5fc; padding:20px; border-radius:10px;">
                    <h4 style="margin-bottom:10px; color:#4a0082;">+ 신규 메뉴 추가하기</h4>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <select id="addCategorySelect" style="width:140px; padding:10px; border:1px solid #ccc; border-radius:6px;">
                            <option value="안전">🛡️ 안전 (Safety)</option>
                            <option value="보건">🩺 보건 (Health)</option>
                            <option value="환경">🌱 환경 (Environment)</option>
                            <option value="교육">🎓 교육 (Education)</option>
                            <option value="기타">📂 기타 (Others)</option>
                        </select>
                        <select id="addMenuIcon" style="width:100px; padding:10px; font-size:14px; border:1px solid #ccc; border-radius:6px;">
                            <option value="📄">📄 문서</option><option value="📜">📜 방침</option><option value="⚖️">⚖️ 법령</option><option value="👥">👥 조직</option>
                            <option value="🚨">🚨 비상</option><option value="⚠️">⚠️ 위험</option><option value="📞">📞 연락</option><option value="📊">📊 통계</option>
                            <option value="🏥">🏥 보건</option><option value="🥽">🥽 보호구</option><option value="🌿">🌿 환경</option><option value="🏭">🏭 배출</option>
                            <option value="💧">💧 수계</option><option value="♻️">♻️ 폐기물</option><option value="🎬">🎬 영상</option><option value="📚">📚 교육</option>
                            <option value="📁">📁 폴더</option><option value="💡">💡 아이디어</option><option value="🧪">🧪 화학물질</option><option value="🔥">🔥 화기</option><option value="🏗️">🏗️ 공사</option>
                        </select>
                        <input type="text" id="addMenuTitle" placeholder="메뉴 이름" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="text" id="addMenuDesc" placeholder="설명 문구" style="width:250px; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" onclick="addNewMenu()">+ 메뉴 추가</button>
                    </div>
                </div>
                <h3 style="margin-top:25px; font-size:16px;">📋 현재 현황판 전체 섹션별 메뉴 리스트</h3>
                <table>
                    <thead><tr><th style="width: 12%;">소속 구획</th><th style="width: 8%; text-align:center;">아이콘</th><th style="width: 20%;">메뉴 이름</th><th style="width: 25%;">메뉴 설명 문구</th><th style="width: 15%;">순서 변경</th><th style="width: 10%;">구획 이동</th><th>관리</th></tr></thead>
                    <tbody id="adminMenuListBody"></tbody>
                </table>
            </div>

            <!-- 탭12: 경영방침 관리 -->
            <div id="tab12" class="panel">
                <h2 style="color:#0277bd; border-bottom: 2px solid #e1f5fe; margin-bottom: 20px;">📜 환경안전보건 경영방침 관리 (개정이력 관리)</h2>
                <div style="background:#e1f5fe; border:2px solid #0277bd; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#0277bd; font-size:16px; margin-bottom:12px;">📝 경영방침 페이지 제목 및 안내 문구 설정</h3>
                    <input type="text" id="policyTitleInput" placeholder="메인 제목" style="width:100%; padding:10px; margin-bottom:10px;">
                    <input type="text" id="policyDescInput" placeholder="안내 문구" style="width:100%; padding:10px; margin-bottom:15px;">
                    <button class="submit-btn" style="width:100%; background:#0277bd;" onclick="savePolicyText()">💾 제목 및 문구 저장</button>
                </div>
                <div style="background:#faf8fc; border:1px solid #eae2f0; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#333; font-size:16px; margin-bottom:12px;">📂 신규 개정판 경영방침 업로드</h3>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <input type="text" id="policyRevTitle" placeholder="버전/개정명" style="flex:2; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="date" id="policyRevDate" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="file" id="policyRevFile" accept=".pdf, image/jpeg, image/png" style="flex:1.5; padding:8px; background:#fff; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" style="padding:10px 20px; background:#333;" onclick="uploadPolicyRevision()">+ 개정판 등록</button>
                    </div>
                </div>
                <h3 style="font-size:16px; margin-bottom:10px;">📋 경영방침 개정이력 목록</h3>
                <table>
                    <thead><tr><th style="width: 45%;">버전/개정명</th><th style="width: 15%;">개정 일자</th><th style="width: 25%;">첨부 파일명</th><th style="width: 15%; text-align:center;">관리</th></tr></thead>
                    <tbody id="adminPolicyHistoryBody"></tbody>
                </table>
            </div>

            <!-- 탭13: 산안법령 요지 관리 -->
            <div id="tab13" class="panel">
                <h2 style="color:#f57c00; border-bottom: 2px solid #fff3e0; margin-bottom: 20px;">⚖️ 산안법령 요지 관리 (개정이력 관리)</h2>
                <div style="background:#fff3e0; border:2px solid #f57c00; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#f57c00; font-size:16px; margin-bottom:12px;">📝 산안법령 페이지 제목 및 안내 문구 설정</h3>
                    <input type="text" id="lawTitleInput" placeholder="메인 제목" style="width:100%; padding:10px; margin-bottom:10px;">
                    <input type="text" id="lawDescInput" placeholder="안내 문구" style="width:100%; padding:10px; margin-bottom:15px;">
                    <button class="submit-btn" style="width:100%; background:#f57c00;" onclick="saveLawText()">💾 제목 및 문구 저장</button>
                </div>
                <div style="background:#faf8fc; border:1px solid #eae2f0; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#333; font-size:16px; margin-bottom:12px;">📂 신규 개정판 산안법령 요지 업로드</h3>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <input type="text" id="lawRevTitle" placeholder="버전/개정명" style="flex:2; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="date" id="lawRevDate" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="file" id="lawRevFile" accept=".pdf, image/jpeg, image/png" style="flex:1.5; padding:8px; background:#fff; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" style="padding:10px 20px; background:#333;" onclick="uploadLawRevision()">+ 등록</button>
                    </div>
                </div>
                <h3 style="font-size:16px; margin-bottom:10px;">📋 산안법령 개정이력 목록</h3>
                <table>
                    <thead><tr><th style="width: 45%;">버전/개정명</th><th style="width: 15%;">등록 일자</th><th style="width: 25%;">첨부 파일명</th><th style="width: 15%; text-align:center;">관리</th></tr></thead>
                    <tbody id="adminLawHistoryBody"></tbody>
                </table>
            </div>

            <!-- 탭14: 위험성평가 관리 -->
            <div id="tab14" class="panel">
                <h2 style="color:#e65100; border-bottom: 2px solid #fff3e0; margin-bottom: 20px;">⚠️ 위험성평가 자료 관리 (부서별)</h2>
                <div style="background:#fff3e0; border:1px solid #f57c00; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#e65100; font-size:16px; margin-bottom:12px;">🏢 1. 평가 대상 부서 관리</h3>
                    <div style="display:flex; gap:10px; margin-bottom:15px; max-width:400px;">
                        <input type="text" id="newRiskDeptInput" placeholder="신규 부서명 입력" style="flex:1; padding:8px; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" style="background:#e65100;" onclick="addRiskDept()">+ 부서 추가</button>
                    </div>
                    <div id="adminRiskDeptTags" style="display:flex; flex-wrap:wrap; gap:8px;"></div>
                </div>
                <div style="background:#faf8fc; border:1px solid #eae2f0; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#333; font-size:16px; margin-bottom:12px;">📂 2. 신규 위험성평가 업로드</h3>
                    <div style="display:grid; grid-template-columns: 1fr 2fr 2fr; gap:10px; margin-bottom:10px;">
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">부서 선택</label><select id="riskRevDept" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></select></div>
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">평가명(제목)</label><input type="text" id="riskRevTitle" placeholder="예: 2026년 정기평가" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></div>
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">첨부파일(다중 선택 가능)</label><input type="file" id="riskRevFile" accept=".pdf, image/jpeg, image/png" multiple style="width:100%; padding:8px; background:#fff; border:1px solid #ccc; border-radius:6px;"></div>
                    </div>
                    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr auto; gap:10px; align-items:end;">
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">등록 일자</label><input type="date" id="riskRevDate" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></div>
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">평가기간 시작일</label><input type="date" id="riskPeriodStart" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></div>
                        <div><label style="font-size:12px; font-weight:bold; color:#666;">평가기간 종료일</label><input type="date" id="riskPeriodEnd" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></div>
                        <button class="submit-btn" style="padding:10px 30px; height:40px; background:#333;" onclick="uploadRiskRevision()">+ 자료 등록</button>
                    </div>
                </div>
                <h3 style="font-size:16px; margin-bottom:10px;">📋 등록된 위험성평가 목록</h3>
                <table>
                    <thead><tr><th style="width: 15%;">부서명</th><th style="width: 30%;">평가명(제목)</th><th style="width: 15%;">평가 기간</th><th style="width: 15%;">등록 일자</th><th style="width: 10%;">첨부</th><th style="width: 15%; text-align:center;">관리</th></tr></thead>
                    <tbody id="adminRiskHistoryBody"></tbody>
                </table>
            </div>

            <!-- 탭15: 안전인증서 관리 -->
            <div id="tab15" class="panel">
                <h2 style="color:#00838f; border-bottom: 2px solid #e0f7fa; margin-bottom: 20px;">📜 안전인증서 관리 (다중 첨부 및 분류)</h2>
                
                <div style="background:#e0f7fa; border:1px solid #00838f; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#00838f; font-size:16px; margin-bottom:12px;">📂 1. 인증서 분류(섹션) 관리</h3>
                    <div style="display:flex; gap:10px; margin-bottom:15px; max-width:400px;">
                        <input type="text" id="newCertCatInput" placeholder="새로운 분류 입력 (예: 방호장치)" style="flex:1; padding:8px; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" style="background:#00838f;" onclick="addCertCategory()">+ 분류 추가</button>
                    </div>
                    <div id="adminCertCatTags" style="display:flex; flex-wrap:wrap; gap:8px;"></div>
                </div>

                <div style="background:#faf8fc; border:1px solid #eae2f0; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#333; font-size:16px; margin-bottom:12px;">📤 2. 신규 안전인증서 등록</h3>
                    <div style="display:grid; grid-template-columns: 1fr 2fr; gap:10px; margin-bottom:10px;">
                        <div>
                            <label style="font-size:12px; font-weight:bold; color:#666;">분류 선택</label>
                            <select id="certRevCat" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></select>
                        </div>
                        <div>
                            <label style="font-size:12px; font-weight:bold; color:#666;">인증서명(제목)</label>
                            <input type="text" id="certRevTitle" placeholder="예: KCs 안전인증서 (안전모)" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        </div>
                    </div>
                    <div style="display:grid; grid-template-columns: 1fr 2fr auto; gap:10px; align-items:end;">
                        <div>
                            <label style="font-size:12px; font-weight:bold; color:#666;">등록(발급) 일자</label>
                            <input type="date" id="certRevDate" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        </div>
                        <div>
                            <label style="font-size:12px; font-weight:bold; color:#666;">첨부파일 (다중 선택 가능 - PDF, 이미지)</label>
                            <input type="file" id="certRevFile" accept=".pdf, image/jpeg, image/png" multiple style="width:100%; padding:8px; background:#fff; border:1px solid #ccc; border-radius:6px;">
                        </div>
                        <button class="submit-btn" style="padding:10px 30px; height:40px; background:#333;" onclick="uploadCertRevision()">+ 자료 등록</button>
                    </div>
                </div>

                <h3 style="font-size:16px; margin-bottom:10px;">📋 등록된 안전인증서 목록</h3>
                <table>
                    <thead><tr><th style="width: 15%;">분류</th><th style="width: 35%;">인증서명(제목)</th><th style="width: 15%;">등록 일자</th><th style="width: 15%;">첨부 파일</th><th style="width: 20%; text-align:center;">관리</th></tr></thead>
                    <tbody id="adminCertHistoryBody"></tbody>
                </table>
            </div>

            <!-- 탭8: 조직도 관리 -->
            <div id="tab8" class="panel">
                <h2>👥 안전보건 조직도 관리 (개정이력 관리)</h2>
                <div style="background:#f8f5fc; border:1px solid #4a0082; padding:20px; border-radius:12px; margin-bottom:24px;">
                    <h3 style="color:#4a0082; font-size:16px; margin-bottom:12px;">📂 신규 개정판 조직도 업로드</h3>
                    <div style="display:flex; gap:10px; margin-bottom:10px; align-items:center;">
                        <input type="text" id="orgRevTitle" placeholder="버전/개정명" style="flex:2; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="date" id="orgRevDate" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;">
                        <input type="file" id="orgRevFile" accept=".pdf, image/jpeg, image/png" style="flex:1.5; padding:8px; background:#fff; border:1px solid #ccc; border-radius:6px;">
                        <button class="submit-btn" style="padding:10px 20px;" onclick="uploadOrgRevision()">+ 개정판 등록</button>
                    </div>
                </div>
                <h3 style="font-size:16px; margin-bottom:10px;">📋 조직도 개정이력 목록</h3>
                <table>
                    <thead><tr><th style="width: 45%;">버전/개정명</th><th style="width: 15%;">개정 일자</th><th style="width: 25%;">첨부 파일명</th><th style="width: 15%; text-align:center;">관리</th></tr></thead>
                    <tbody id="adminOrgHistoryBody"></tbody>
                </table>
            </div>

            <!-- 탭9: 산안위 관리 -->
