    <script src="/js/admin.js"></script>
    <script>
        async function fetchDB() { const res = await fetch('/api/db'); return await res.json(); }
        async function saveDB(key, value) { await fetch('/api/db', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key, value: value ? JSON.stringify(value) : null }) }); }
        const readAsDataURL = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = (e) => resolve(e.target.result); reader.onerror = (e) => reject(e); reader.readAsDataURL(file); });
        const readAsDataURL_multi = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = (e) => resolve({ fileName: file.name, fileUrl: e.target.result }); reader.onerror = (e) => reject(e); reader.readAsDataURL(file); });

        async function renderDynamicSidebar() {
            const db = await fetchDB(); 
            let menus = db['esol_menu_structure'];
            menus = menus ? JSON.parse(menus) : (typeof defaultMenus !== 'undefined' ? defaultMenus : { '안전': [], '보건': [], '환경': [], '교육': [], '기타': [] });
            const container = document.getElementById('dynamicNavGroups');
            if (!container) return;

            const sectionIcons = { '안전': '🛡️', '보건': '🩺', '환경': '🌱', '교육': '🎓', '기타': '📂' };
            const menuActionMap = {
                '안전보건 경영방침': "switchPanel('tab12', this); renderAdminPolicy();",
                '산안법령 요지': "switchPanel('tab13', this); renderAdminLaw();",
                '안전보건 조직도': "switchPanel('tab8', this); renderAdminOrgTable();",
                '산업안전보건위원회': "switchPanel('tab9', this); renderAdminCommittee();",
                '비상대응 매뉴얼': "switchPanel('tab10', this); renderAdminEmergency();",
                '비상연락망': "switchPanel('tab11', this); renderAdminContact();",
                "Today's DRI": "switchPanel('tab7', this);renderDriDepts(); loadAdminDriList(1);",
                'MSDS 및 공정별 관리요령 관리': "switchPanel('tab6', this); loadAdminMsdsList();",
                '보호구 지급/설정': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '보호구 관리 및 지급대장': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '보호구 관리': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '위험성평가표': "switchPanel('tab14', this); renderAdminRisk();",
                '위험성평가': "switchPanel('tab14', this); renderAdminRisk();",
                '부서별 위험성평가': "switchPanel('tab14', this); renderAdminRisk();",
                '안전인증서': "switchPanel('tab15', this); renderAdminCert();",
                '위험성평가 관리': "switchPanel('tab14', this); renderAdminRisk();",
                // 💡 특수건강검진 연결
                '근로자 건강관리 (건강검진)': "switchPanel('tab16', this); loadAdminHealthData();" 
            };

            let html = '';
            for (const catKey in menus) {
                const icon = sectionIcons[catKey] || '📌';
                const navId = 'nav-' + catKey;
                const list = menus[catKey] || [];
                html += `<div class="nav-group"><div class="nav-title" onclick="toggleNav('${navId}')">${icon} ${catKey} <span class="arrow">▼</span></div><div class="nav-items" id="${navId}">`;
                list.forEach((m) => {
                    const action = menuActionMap[m.title] || "switchPanel('tab1', this);";
                    html += `<button class="nav-item" onclick="${action}">${m.icon || '📄'} ${m.title}</button>`;
                });
                html += `</div></div>`;
            }
            container.innerHTML = html;
        }

        // 💡 [탭4: 계정 관리 - 등록/수정/삭제 로직]
        async function loadAdminUserList() {
            const db = await fetchDB();
            const users = db['esol_users_data'] ? JSON.parse(db['esol_users_data']) : [];
            const tbody = document.getElementById('adminUserListBody');
            if(!tbody) return;
            if (users.length === 0) return tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:15px; color:#888;">등록된 계정이 없습니다.</td></tr>`;
            
            tbody.innerHTML = users.map(u => `
                <tr>
                    <td>${u.dept}</td>
                    <td style="font-weight:bold;">${u.name}</td>
                    <td>${u.empNo}</td>
                    <td>${u.pw}</td>
                    <td style="text-align:center;">
                        <button class="submit-btn" style="background:#ff9800; padding:5px 10px; font-size:12px; margin-right:4px;" onclick="editUserAccount('${u.id}')">수정</button>
                        <button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deleteUserAccount('${u.id}')">삭제</button>
                    </td>
                </tr>
            `).join('');
        }

        async function registerUserAccount() {
            const editId = document.getElementById('editUserTargetId').value;
            const dept = document.getElementById('newUserDept').value.trim();
            const name = document.getElementById('newUserName').value.trim();
            const empNo = document.getElementById('newUserEmpNo').value.trim();
            const pw = document.getElementById('newUserPw').value.trim();

            if (!dept || !name || !empNo || !pw) return alert('모든 항목을 입력해주세요.');

            const db = await fetchDB();
            let users = db['esol_users_data'] ? JSON.parse(db['esol_users_data']) : [];

            if (editId) {
                const idx = users.findIndex(u => u.id === editId);
                if(idx !== -1) {
                    users[idx].dept = dept;
                    users[idx].name = name;
                    users[idx].empNo = empNo;
                    users[idx].pw = pw;
                }
                alert('계정 정보가 수정되었습니다.');
            } else {
                if (users.find(u => u.empNo === empNo)) return alert('이미 존재하는 사번(ID)입니다.');
                users.push({ id: Date.now().toString(), dept, name, empNo, pw });
                alert('새로운 계정이 등록되었습니다.');
            }

            await saveDB('esol_users_data', users);
            cancelEditUser();
            loadAdminUserList();
        }

        async function editUserAccount(id) {
            const db = await fetchDB();
            const users = db['esol_users_data'] ? JSON.parse(db['esol_users_data']) : [];
            const user = users.find(u => u.id === id);
            if(!user) return;

            document.getElementById('editUserTargetId').value = user.id;
            document.getElementById('newUserDept').value = user.dept;
            document.getElementById('newUserName').value = user.name;
            document.getElementById('newUserEmpNo').value = user.empNo;
            document.getElementById('newUserPw').value = user.pw;

            document.getElementById('userFormTitle').innerText = '✏️ 계정 정보 수정';
            document.getElementById('userSubmitBtn').innerText = '수정 저장';
            document.getElementById('userCancelBtn').style.display = 'inline-block';
        }

        function cancelEditUser() {
            document.getElementById('editUserTargetId').value = '';
            document.getElementById('newUserDept').value = '';
            document.getElementById('newUserName').value = '';
            document.getElementById('newUserEmpNo').value = '';
            document.getElementById('newUserPw').value = '';

            document.getElementById('userFormTitle').innerText = '➕ 신규 계정 등록';
            document.getElementById('userSubmitBtn').innerText = '+ 계정 등록';
            document.getElementById('userCancelBtn').style.display = 'none';
        }

        async function deleteUserAccount(id) {
            if (!confirm('이 계정을 삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let users = db['esol_users_data'] ? JSON.parse(db['esol_users_data']) : [];
            users = users.filter(u => u.id !== id);
            await saveDB('esol_users_data', users);
            loadAdminUserList();
        }

        // ==========================================
        // 기존 공통 이력 관리 로직 유지
        // ==========================================

        async function openHistoryEditModal(dbKey, id) {
            const db = await fetchDB();
            const list = db[dbKey] ? JSON.parse(db[dbKey]) : [];
            const item = list.find(m => m.id == id);
            if (!item) return;

            document.getElementById('editHistDbKey').value = dbKey;
            document.getElementById('editHistId').value = id;
            document.getElementById('editHistTitleInput').value = item.title;
            document.getElementById('editHistDateInput').value = item.date;
            
            const fileInput = document.getElementById('editHistFileInput');
            fileInput.value = '';

            if(document.getElementById('editHistCategoryGroup')) document.getElementById('editHistCategoryGroup').style.display = 'none';
            
            if (dbKey === 'esol_risk_history') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'block';
                document.getElementById('editHistPeriodGroup').style.display = 'block';
                const depts = db['esol_risk_depts'] ? JSON.parse(db['esol_risk_depts']) : [];
                document.getElementById('editHistDeptSelect').innerHTML = depts.map(d => `<option value="${d}" ${d===item.dept?'selected':''}>${d}</option>`).join('');
                document.getElementById('editHistPeriodStart').value = item.periodStart || '';
                document.getElementById('editHistPeriodEnd').value = item.periodEnd || '';
            
            } else if (dbKey === 'esol_cert_history') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'none';
                if(document.getElementById('editHistPeriodGroup')) document.getElementById('editHistPeriodGroup').style.display = 'none';
                
                if(document.getElementById('editHistCategoryGroup')) {
                    document.getElementById('editHistCategoryGroup').style.display = 'block';
                    const cats = db['esol_cert_categories'] ? JSON.parse(db['esol_cert_categories']) : ['보호구', '방호장치', '기타'];
                    document.getElementById('editHistCategorySelect').innerHTML = cats.map(c => `<option value="${c}" ${c===item.category?'selected':''}>${c}</option>`).join('');
                }

            } else if (dbKey === 'esol_committee_minutes') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'none';
                if(document.getElementById('editHistPeriodGroup')) document.getElementById('editHistPeriodGroup').style.display = 'none';
            } else {
                fileInput.multiple = false;
