                    <thead><tr><th>신청일시</th><th>부서명</th><th>신청자(사번)</th><th>보호구 종류</th><th>신청 목적</th><th style="text-align:center;">지급 상태</th><th style="text-align:center;">수령 서명</th><th style="text-align:center;">관리</th></tr></thead>
                    <tbody id="adminPpeRequestsTableBody"></tbody>
                </table>
            </div>

            <!-- 탭2: 시스템 설정 -->
            <div id="tab2" class="panel">
                <h2>✏️ 시스템 설정</h2>
                <div style="background:#f8f9fa; border:1px solid #ddd; padding:20px; border-radius:10px; margin-bottom:24px;">
                    <div class="form-group"><label>플랫폼 대표 제목</label><input type="text" id="siteTitleInput"></div>
                    <div class="form-group"><label>안내 문구</label><input type="text" id="siteSubTextInput"></div>
                    <button class="submit-btn" onclick="saveTextSettings()">💾 저장</button>
                </div>
                <div style="background:#fff2f2; border:1px solid #ffcdd2; padding:20px; border-radius:10px;">
                    <h3 style="color:#e53935; font-size:16px; margin-bottom:12px;">🔒 관리자 비밀번호 변경</h3>
                    <div style="display:flex; gap:10px; max-width:600px;">
                        <input type="password" id="newAdminPwInput" placeholder="새 비밀번호 입력" style="padding:10px; border:1px solid #ccc; border-radius:6px; flex:1;">
                        <button class="submit-btn" style="background:#e53935;" onclick="changeAdminPassword()">🔒 비밀번호 변경</button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- 💡 [복구됨] 모달 영역: 개정이력 수정, 보호구 서명, 메뉴 수정 등 -->
    <div class="custom-modal-overlay" id="historyEditModal">
        <div class="custom-modal-box">
            <div class="custom-modal-header"><h3 id="historyEditModalTitle">📝 내역 수정</h3><button onclick="closeHistoryEditModal()" style="background:none; border:none; font-size:20px; cursor:pointer;">✕</button></div>
            <input type="hidden" id="editHistDbKey"><input type="hidden" id="editHistId">
            <div class="form-group" id="editHistDeptGroup" style="display:none;"><label>평가 대상 부서</label><select id="editHistDeptSelect" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></select></div>
            <div class="form-group" id="editHistCategoryGroup" style="display:none;"><label>분류 선택</label><select id="editHistCategorySelect" style="width:100%; padding:10px; border:1px solid #ccc; border-radius:6px;"></select></div>
            <div class="form-group"><label>버전/개정명 (제목)</label><input type="text" id="editHistTitleInput"></div>
            <div class="form-group"><label>등록 일자</label><input type="date" id="editHistDateInput"></div>
            <div class="form-group" id="editHistPeriodGroup" style="display:none;">
                <label>평가 기간</label>
                <div style="display:flex; gap:10px; align-items:center;">
                    <input type="date" id="editHistPeriodStart" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;"><span>~</span><input type="date" id="editHistPeriodEnd" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:6px;">
                </div>
            </div>
            <div class="form-group"><label style="color:#b0268d;">첨부파일 변경 (선택사항)</label><input type="file" id="editHistFileInput" style="background:#f8f9fa;" accept=".pdf, image/jpeg, image/png"></div>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;"><button class="submit-btn" style="background:#888;" onclick="closeHistoryEditModal()">취소</button><button class="submit-btn" onclick="saveHistoryEditModal()">💾 저장</button></div>
        </div>
    </div>

    <div class="custom-modal-overlay" id="ppeGuideEditModal">
        <div class="custom-modal-box">
            <div class="custom-modal-header"><h3 id="ppeGuideModalTitle">📌 지침 편집</h3><button onclick="closePpeGuideModal()" style="background:none; border:none; font-size:20px; cursor:pointer;">✕</button></div>
            <input type="hidden" id="editPpeGuideIndex" value="-1">
            <div class="form-group"><label>공정 명칭</label><input type="text" id="editPpeProcessInput"></div>
            <div class="form-group"><label>보호구 목록</label><textarea id="editPpeItemsInput" rows="3"></textarea></div>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;"><button class="submit-btn" style="background:#888;" onclick="closePpeGuideModal()">취소</button><button class="submit-btn" onclick="savePpeGuideModal()">💾 저장</button></div>
        </div>
    </div>

    <div class="custom-modal-overlay" id="menuEditModal">
        <div class="custom-modal-box">
            <div class="custom-modal-header"><h3 id="menuEditModalTitle">✏️ 메뉴 정보 수정</h3><button onclick="closeMenuEditModal()" style="background:none; border:none; font-size:20px; cursor:pointer;">✕</button></div>
            <input type="hidden" id="editMenuCat" value=""><input type="hidden" id="editMenuIndex" value="-1">
            <div class="form-group"><label>아이콘 선택</label><select id="editMenuIcon" style="width:100%; padding:10px; font-size:14px; border:1px solid #ccc; border-radius:6px;"><option value="📄">📄 문서</option></select></div>
            <div class="form-group"><label>메뉴 이름</label><input type="text" id="editMenuTitleInput"></div>
            <div class="form-group"><label>설명 문구</label><input type="text" id="editMenuDescInput"></div>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;"><button class="submit-btn" style="background:#888;" onclick="closeMenuEditModal()">취소</button><button class="submit-btn" onclick="saveMenuEditModal()">💾 저장</button></div>
        </div>
    </div>

    <!-- 스크립트 영역 (기존 함수 통합 및 누락분 복구) -->
    <script src="/js/admin.js"></script>
    <script>
        // 💡 [DB 통신 유틸 함수]
        async function fetchDB() { const res = await fetch('/api/db'); return await res.json(); }
        async function saveDB(key, value) { await fetch('/api/db', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key, value: value ? JSON.stringify(value) : null }) }); }
        const readAsDataURL = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = (e) => resolve(e.target.result); reader.onerror = (e) => reject(e); reader.readAsDataURL(file); });
        const readAsDataURL_multi = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = (e) => resolve({ fileName: file.name, fileUrl: e.target.result }); reader.onerror = (e) => reject(e); reader.readAsDataURL(file); });

        // 💡 [복구됨] 동적 사이드바 렌더링
        async function renderDynamicSidebar() {
            const db = await fetchDB(); 
            let menus = db['esol_menu_structure'];
            menus = menus ? JSON.parse(menus) : (typeof defaultMenus !== 'undefined' ? defaultMenus : { '안전': [], '보건': [], '환경': [], '교육': [], '기타': [] });
            const container = document.getElementById('dynamicNavGroups');
            if (!container) return;

            const sectionIcons = { '안전': '🛡️', '보건': '🩺', '환경': '🌱', '교육': '🎓', '기타': '📂' };
            const menuActionMap = {
                '안전보건 경영방침': "switchPanel('tab12', this); renderAdminPolicy();",
                '산안법령 요지': "switchPanel('tab13', this); renderAdminLaw();",
                '안전보건 조직도': "switchPanel('tab8', this); renderAdminOrgTable();",
                '산업안전보건위원회': "switchPanel('tab9', this); renderAdminCommittee();",
                '비상대응 매뉴얼': "switchPanel('tab10', this); renderAdminEmergency();",
                '비상연락망': "switchPanel('tab11', this); renderAdminContact();",
                "Today's DRI": "switchPanel('tab7', this);renderDriDepts(); loadAdminDriList(1);",
                '화학물질 자료실 / MSDS': "switchPanel('tab6', this);",
                '화학물질 자료실': "switchPanel('tab6', this);",
                'MSDS 자료 관리': "switchPanel('tab6', this);",
                '보호구 지급/설정': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '보호구 관리 및 지급대장': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '보호구 관리': "switchPanel('tab3', this); loadAdminPpeManagement();",
                '위험성평가표': "switchPanel('tab14', this); renderAdminRisk();",
                '위험성평가': "switchPanel('tab14', this); renderAdminRisk();",
                '부서별 위험성평가': "switchPanel('tab14', this); renderAdminRisk();",
                '안전인증서': "switchPanel('tab15', this); renderAdminCert();",
                '위험성평가 관리': "switchPanel('tab14', this); renderAdminRisk();"
            };

            let html = '';
            for (const catKey in menus) {
                const icon = sectionIcons[catKey] || '📌';
                const navId = 'nav-' + catKey;
                const list = menus[catKey] || [];
                html += `<div class="nav-group"><div class="nav-title" onclick="toggleNav('${navId}')">${icon} ${catKey} <span class="arrow">▼</span></div><div class="nav-items" id="${navId}">`;
                list.forEach((m) => {
                    const action = menuActionMap[m.title] || "switchPanel('tab1', this);";
                    html += `<button class="nav-item" onclick="${action}">${m.icon || '📄'} ${m.title}</button>`;
                });
                html += `</div></div>`;
            }
            container.innerHTML = html;
        }

        // 💡 [복구됨] 공통 이력 수정 팝업 제어 (창 열기)
        async function openHistoryEditModal(dbKey, id) {
            const db = await fetchDB();
            const list = db[dbKey] ? JSON.parse(db[dbKey]) : [];
            const item = list.find(m => m.id == id);
            if (!item) return;

            document.getElementById('editHistDbKey').value = dbKey;
            document.getElementById('editHistId').value = id;
            document.getElementById('editHistTitleInput').value = item.title;
            document.getElementById('editHistDateInput').value = item.date;
            
            const fileInput = document.getElementById('editHistFileInput');
            fileInput.value = '';

            // 💡 혹시 열려있을 수 있는 카테고리 창을 기본적으로 숨깁니다.
            if(document.getElementById('editHistCategoryGroup')) document.getElementById('editHistCategoryGroup').style.display = 'none';
            
            if (dbKey === 'esol_risk_history') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'block';
                document.getElementById('editHistPeriodGroup').style.display = 'block';
                const depts = db['esol_risk_depts'] ? JSON.parse(db['esol_risk_depts']) : [];
                document.getElementById('editHistDeptSelect').innerHTML = depts.map(d => `<option value="${d}" ${d===item.dept?'selected':''}>${d}</option>`).join('');
                document.getElementById('editHistPeriodStart').value = item.periodStart || '';
                document.getElementById('editHistPeriodEnd').value = item.periodEnd || '';
            
            // 💡 [추가] 안전인증서일 때 카테고리 선택창 띄우기
            } else if (dbKey === 'esol_cert_history') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'none';
                if(document.getElementById('editHistPeriodGroup')) document.getElementById('editHistPeriodGroup').style.display = 'none';
                
                if(document.getElementById('editHistCategoryGroup')) {
                    document.getElementById('editHistCategoryGroup').style.display = 'block';
                    const cats = db['esol_cert_categories'] ? JSON.parse(db['esol_cert_categories']) : ['보호구', '방호장치', '기타'];
                    document.getElementById('editHistCategorySelect').innerHTML = cats.map(c => `<option value="${c}" ${c===item.category?'selected':''}>${c}</option>`).join('');
                }

            } else if (dbKey === 'esol_committee_minutes') {
                fileInput.multiple = true;
                document.getElementById('editHistDeptGroup').style.display = 'none';
                if(document.getElementById('editHistPeriodGroup')) document.getElementById('editHistPeriodGroup').style.display = 'none';
            } else {
                fileInput.multiple = false;
                document.getElementById('editHistDeptGroup').style.display = 'none';
                if(document.getElementById('editHistPeriodGroup')) document.getElementById('editHistPeriodGroup').style.display = 'none';
            }
            document.getElementById('historyEditModal').style.display = 'flex';
        }
  
        function closeHistoryEditModal() { document.getElementById('historyEditModal').style.display = 'none'; }

        async function saveHistoryEditModal() {
            const dbKey = document.getElementById('editHistDbKey').value; const id = document.getElementById('editHistId').value;
            const newTitle = document.getElementById('editHistTitleInput').value.trim(); const newDate = document.getElementById('editHistDateInput').value;
            const fileInput = document.getElementById('editHistFileInput');
            if (!newTitle || !newDate) return alert('제목과 일자를 모두 입력해주세요.');

            const db = await fetchDB(); let list = db[dbKey] ? JSON.parse(db[dbKey]) : [];
            const itemIndex = list.findIndex(m => m.id == id); if (itemIndex === -1) return;

            list[itemIndex].title = newTitle; list[itemIndex].date = newDate;

            if (dbKey === 'esol_risk_history') {
                const pStart = document.getElementById('editHistPeriodStart').value; const pEnd = document.getElementById('editHistPeriodEnd').value;
                if (!pStart || !pEnd) return alert('평가 기간을 모두 선택해주세요.');
                list[itemIndex].dept = document.getElementById('editHistDeptSelect').value; list[itemIndex].periodStart = pStart; list[itemIndex].periodEnd = pEnd;
            }

            // 💡 [추가] 안전인증서 카테고리 정보 저장하기
            if (dbKey === 'esol_cert_history') {
                const catSelect = document.getElementById('editHistCategorySelect');
                if(catSelect) list[itemIndex].category = catSelect.value;
            }

            if (fileInput.files.length > 0) {
                // 💡 다중 파일 첨부 처리 부분에 안전인증서(esol_cert_history)도 추가
                if (dbKey === 'esol_committee_minutes' || dbKey === 'esol_risk_history' || dbKey === 'esol_cert_history') {
                    const filesData = await Promise.all(Array.from(fileInput.files).map(f => readAsDataURL_multi(f))); list[itemIndex].files = filesData;
                } else {
                    const file = fileInput.files[0]; const base64Data = await readAsDataURL(file);
                    list[itemIndex].fileName = file.name; list[itemIndex].fileUrl = base64Data; list[itemIndex].type = file.name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image';
                }
            }

            await saveDB(dbKey, list); closeHistoryEditModal(); alert('수정 내용이 저장되었습니다.');
            if (dbKey === 'esol_policy_history') renderAdminPolicy(); if (dbKey === 'esol_law_history') renderAdminLaw(); if (dbKey === 'esol_org_history') renderAdminOrgTable();
            if (dbKey === 'esol_committee_minutes') renderAdminCommittee(); if (dbKey === 'esol_emergency_history') renderAdminEmergency(); if (dbKey === 'esol_contact_history') renderAdminContact();
            if (dbKey === 'esol_risk_history') renderAdminRisk();
            
            // 💡 [추가] 인증서 수정 완료 후 화면 다시 그리기
            if (dbKey === 'esol_cert_history') renderAdminCert(); 
        }

        // ==========================================
        // 💡 [복구됨] 위험성평가, 보호구, 그리고 나머지 공통 이력 관리 로직
        // ==========================================
        
        // --- 탭14: 위험성평가 ---
        async function renderAdminRisk() {
            const db = await fetchDB();
            const savedDepts = db['esol_risk_depts']; let depts = savedDepts ? JSON.parse(savedDepts) : [];
            document.getElementById('adminRiskDeptTags').innerHTML = depts.map(d => `<span style="background:#ffe0b2; border:1px solid #f57c00; color:#e65100; padding:6px 12px; border-radius:20px; font-size:13px; font-weight:bold;">${d} <button onclick="deleteRiskDept('${d}')" style="border:none; background:none; color:#d32f2f; cursor:pointer;">✕</button></span>`).join('');
            let deptOptions = depts.map(d => `<option value="${d}">${d}</option>`).join('');
            if(depts.length === 0) deptOptions = `<option value="">부서를 먼저 추가하세요</option>`;
            document.getElementById('riskRevDept').innerHTML = deptOptions;

            const list = db['esol_risk_history'] ? JSON.parse(db['esol_risk_history']) : [];
            const tbody = document.getElementById('adminRiskHistoryBody');
            if (list.length === 0) return tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:15px; color:#888;">등록된 이력이 없습니다.</td></tr>`;
            
            tbody.innerHTML = list.map(m => {
                let fileCount = 0; if (m.files && m.files.length > 0) fileCount = m.files.length; else if (m.fileUrl) fileCount = 1;
                const periodStr = (m.periodStart && m.periodEnd) ? `${m.periodStart} ~ ${m.periodEnd}` : '-';
                return `<tr><td style="color:#e65100; font-weight:bold;">${m.dept}</td><td style="font-weight:bold;">${m.title}</td><td style="color:#555; font-size:13px;">${periodStr}</td><td>${m.date}</td><td style="color:#1976d2; font-size:12px;">첨부 ${fileCount}건</td><td style="text-align:center;"><button class="submit-btn" style="background:#ff9800; padding:5px 10px; font-size:12px;" onclick="openHistoryEditModal('esol_risk_history', '${m.id}')">수정</button> <button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deleteRiskRevision('${m.id}')">삭제</button></td></tr>`;
            }).join('');
        }
        async function addRiskDept() { const val = document.getElementById('newRiskDeptInput').value.trim(); if (!val) return; const db = await fetchDB(); const depts = db['esol_risk_depts'] ? JSON.parse(db['esol_risk_depts']) : []; if(depts.includes(val)) return alert('이미 존재하는 부서입니다.'); depts.push(val); await saveDB('esol_risk_depts', depts); document.getElementById('newRiskDeptInput').value = ''; renderAdminRisk(); }
        async function deleteRiskDept(dept) { if (!confirm(`'${dept}' 부서를 삭제하시겠습니까?`)) return; const db = await fetchDB(); let depts = db['esol_risk_depts'] ? JSON.parse(db['esol_risk_depts']) : []; depts = depts.filter(d => d !== dept); await saveDB('esol_risk_depts', depts); renderAdminRisk(); }
        async function uploadRiskRevision() {
            const dept = document.getElementById('riskRevDept').value; const title = document.getElementById('riskRevTitle').value.trim(); const date = document.getElementById('riskRevDate').value; const periodStart = document.getElementById('riskPeriodStart').value; const periodEnd = document.getElementById('riskPeriodEnd').value; const fileInput = document.getElementById('riskRevFile');
            if (!dept || !title || !date || !periodStart || !periodEnd || !fileInput.files.length) return alert('모두 입력해주세요.');
            try { const filesData = await Promise.all(Array.from(fileInput.files).map(f => readAsDataURL_multi(f))); const db = await fetchDB(); const list = db['esol_risk_history'] ? JSON.parse(db['esol_risk_history']) : []; list.unshift({ id: Date.now().toString(), dept, title, date, periodStart, periodEnd, files: filesData }); await saveDB('esol_risk_history', list); alert('✅ 등록 완료'); document.getElementById('riskRevTitle').value = ''; document.getElementById('riskRevDate').value = ''; document.getElementById('riskPeriodStart').value = ''; document.getElementById('riskPeriodEnd').value = ''; fileInput.value = ''; renderAdminRisk(); } catch (err) { alert('에러 발생'); }
        }
        async function deleteRiskRevision(id) { if (!confirm('삭제하시겠습니까?')) return; const db = await fetchDB(); let list = db['esol_risk_history'] ? JSON.parse(db['esol_risk_history']) : []; list = list.filter(m => m.id !== id); await saveDB('esol_risk_history', list); renderAdminRisk(); }

        // --- 탭3: 보호구 고도화 관리 ---
        async function loadAdminPpeManagement() { await loadAdminPpeTypes(); await loadAdminPpeSection(); await loadAdminPpeRequests(); }
        async function loadAdminPpeTypes() {
            const db = await fetchDB(); let types = db['esol_ppe_types'] ? JSON.parse(db['esol_ppe_types']) : ['안전모', '안전화', '보안경', '방진마스크', '방독마스크', '안전장갑', '귀마개'];
            const container = document.getElementById('adminPpeTypeTags');
            if(container) container.innerHTML = types.map(t => `<span style="background:#fff3e0; border:1px solid #ffb300; color:#ff8f00; padding:6px 12px; border-radius:20px; font-size:13px; font-weight:bold;">${t} <button onclick="deletePpeType('${t}')" style="border:none; background:none; color:#d32f2f; cursor:pointer;">✕</button></span>`).join('');
        }
        async function addPpeType() { const val = document.getElementById('newPpeTypeInput').value.trim(); if (!val) return; const db = await fetchDB(); let types = db['esol_ppe_types'] ? JSON.parse(db['esol_ppe_types']) : ['안전모', '안전화', '보안경', '방진마스크', '방독마스크', '안전장갑', '귀마개']; if(types.includes(val)) return alert('이미 존재하는 보호구입니다.'); types.push(val); await saveDB('esol_ppe_types', types); document.getElementById('newPpeTypeInput').value = ''; loadAdminPpeTypes(); }
        async function deletePpeType(type) { if (!confirm(`'${type}' 항목을 삭제하시겠습니까?`)) return; const db = await fetchDB(); let types = db['esol_ppe_types'] ? JSON.parse(db['esol_ppe_types']) : ['안전모', '안전화', '보안경', '방진마스크', '방독마스크', '안전장갑', '귀마개']; types = types.filter(t => t !== type); await saveDB('esol_ppe_types', types); loadAdminPpeTypes(); }
        async function loadAdminPpeSection() {
            const db = await fetchDB(); const guides = db['esol_ppe_guides'] ? JSON.parse(db['esol_ppe_guides']) : [{ process: '용접 작업 공정', items: '용접면, 방진마스크, 가죽안전장갑' }, { process: '화학물질 취급 공정', items: '내화학안전장갑, 보안경, 방독마스크' }];
            const tbody = document.getElementById('adminPpeGuideTableBody'); if (!tbody) return;
            if (guides.length === 0) return tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding:15px; color:#888;">등록된 지침이 없습니다.</td></tr>`;
            tbody.innerHTML = guides.map((g, idx) => `<tr><td style="font-weight:bold; color:#512da8;">${g.process}</td><td>${g.items}</td><td style="text-align:center;"><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deletePpeGuide(${idx})">삭제</button></td></tr>`).join('');
        }
        async function addPpeGuide() { const process = document.getElementById('newPpeProcess').value.trim(); const items = document.getElementById('newPpeItems').value.trim(); if (!process || !items) return alert('모두 입력해주세요.'); const db = await fetchDB(); let guides = db['esol_ppe_guides'] ? JSON.parse(db['esol_ppe_guides']) : []; guides.push({ process, items }); await saveDB('esol_ppe_guides', guides); document.getElementById('newPpeProcess').value = ''; document.getElementById('newPpeItems').value = ''; loadAdminPpeSection(); }
        async function deletePpeGuide(idx) { if (!confirm('삭제하시겠습니까?')) return; const db = await fetchDB(); let guides = db['esol_ppe_guides'] ? JSON.parse(db['esol_ppe_guides']) : []; guides.splice(idx, 1); await saveDB('esol_ppe_guides', guides); loadAdminPpeSection(); }
        async function loadAdminPpeRequests() {
            const db = await fetchDB(); const requests = db['esol_ppe_requests'] ? JSON.parse(db['esol_ppe_requests']) : []; const tbody = document.getElementById('adminPpeRequestsTableBody'); if (!tbody) return;
            if (requests.length === 0) return tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:20px; color:#888;">접수된 보호구 신청 내역이 없습니다.</td></tr>`;
            tbody.innerHTML = requests.map((r, idx) => {
                let signDisplay = `<span style="color:#d32f2f; font-size:12px;">미서명</span>`; if (r.signature) signDisplay = `<img src="${r.signature}" style="height:30px; border:1px solid #ccc; background:#fff;" alt="서명">`;
                let statusColor = r.status === '지급완료' ? '#2e7d32' : '#e65100';
                return `<tr><td>${r.date || '-'}</td><td style="font-weight:bold;">${r.dept}</td><td>${r.name} (${r.empNo})</td><td>${r.item}</td><td>${r.purpose}</td><td style="text-align:center; font-weight:bold; color:${statusColor};">${r.status || '신청접수'}</td><td style="text-align:center;">${signDisplay}</td><td style="text-align:center;"><div style="display:flex; gap:5px; justify-content:center;"><button class="submit-btn" style="background:#512da8; padding:5px 10px; font-size:12px;" onclick="togglePpeStatus(${idx})">상태변경</button><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deletePpeRequest(${idx})">삭제</button></div></td></tr>`;
            }).join('');
        }
        async function togglePpeStatus(idx) { const db = await fetchDB(); let requests = db['esol_ppe_requests'] ? JSON.parse(db['esol_ppe_requests']) : []; if (!requests[idx]) return; requests[idx].status = requests[idx].status === '지급완료' ? '신청접수' : '지급완료'; await saveDB('esol_ppe_requests', requests); loadAdminPpeRequests(); }
        async function deletePpeRequest(idx) { if (!confirm('삭제하시겠습니까?')) return; const db = await fetchDB(); let requests = db['esol_ppe_requests'] ? JSON.parse(db['esol_ppe_requests']) : []; requests.splice(idx, 1); await saveDB('esol_ppe_requests', requests); loadAdminPpeRequests(); }

