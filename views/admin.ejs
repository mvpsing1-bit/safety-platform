            } catch (err) { alert('업로드 에러 발생'); }
        }
        async function deleteCntRevision(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_contact_history'] ? JSON.parse(db['esol_contact_history']) : [];
            list = list.filter(m => m.id !== id); await saveDB('esol_contact_history', list); renderAdminContact();
        }

        // ==========================================
        // 4. 산안위 관리 DB 연동
        // ==========================================
        async function renderAdminCommittee() {
            const db = await fetchDB();
            const savedNotice = db['esol_committee_notice'];
            if (savedNotice) {
                const notice = JSON.parse(savedNotice);
                document.getElementById('cmtNoticeActive').checked = notice.isActive;
                document.getElementById('cmtNoticeTitle').value = notice.title;
                document.getElementById('cmtNoticeDate').value = notice.date;
                document.getElementById('cmtNoticeTime').value = notice.time;
                document.getElementById('cmtNoticeLocation').value = notice.location;
                document.getElementById('cmtNoticeAttendees').value = notice.attendees;
            }
            const list = db['esol_committee_minutes'] ? JSON.parse(db['esol_committee_minutes']) : [];
            const tbody = document.getElementById('adminCommitteeMinutesBody');
            if (list.length === 0) return tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:15px; color:#888;">등록된 회의록이 없습니다.</td></tr>`;
            tbody.innerHTML = list.map(m => {
                const fileCount = m.files ? m.files.length : (m.fileName ? 1 : 0);
                return `<tr><td style="font-weight:bold;">${m.title}</td><td>${m.date}</td><td style="color:#1976d2; font-size:12px;">첨부 ${fileCount}건</td><td style="text-align:center;"><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deleteCommitteeMinute('${m.id}')">삭제</button></td></tr>`;
            }).join('');
        }
        async function saveCommitteeNotice() {
            const notice = {
                isActive: document.getElementById('cmtNoticeActive').checked,
                title: document.getElementById('cmtNoticeTitle').value.trim(),
                date: document.getElementById('cmtNoticeDate').value,
                time: document.getElementById('cmtNoticeTime').value,
                location: document.getElementById('cmtNoticeLocation').value.trim(),
                attendees: document.getElementById('cmtNoticeAttendees').value.trim()
            };
            await saveDB('esol_committee_notice', notice); alert('✅ 저장되었습니다.');
        }
        async function uploadCommitteeMinute() {
            const title = document.getElementById('cmtMinuteTitle').value.trim();
            const date = document.getElementById('cmtMinuteDate').value;
            const fileInput = document.getElementById('cmtMinuteFile');
            if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.');
            
            const readAsDataURL_multi = (file) => new Promise((resolve, reject) => {
                const reader = new FileReader(); reader.onload = (e) => resolve({ fileName: file.name, fileUrl: e.target.result }); reader.onerror = (e) => reject(e); reader.readAsDataURL(file);
            });
            try {
                const filesData = await Promise.all(Array.from(fileInput.files).map(f => readAsDataURL_multi(f)));
                const db = await fetchDB();
                const list = db['esol_committee_minutes'] ? JSON.parse(db['esol_committee_minutes']) : [];
                list.unshift({ id: Date.now().toString(), title, date, files: filesData });
                await saveDB('esol_committee_minutes', list); alert('✅ 등록 완료');
                document.getElementById('cmtMinuteTitle').value = ''; document.getElementById('cmtMinuteDate').value = ''; fileInput.value = ''; renderAdminCommittee();
            } catch (err) { alert('업로드 에러 발생'); }
        }
        async function deleteCommitteeMinute(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_committee_minutes'] ? JSON.parse(db['esol_committee_minutes']) : [];
            list = list.filter(m => m.id !== id); await saveDB('esol_committee_minutes', list); renderAdminCommittee();
        }

        // ==========================================
        // 💡 5. 경영방침 관리 DB 연동 (추가됨)
        // ==========================================
        async function renderAdminPolicy() {
            const db = await fetchDB();
            const savedText = db['esol_policy_text'];
            if (savedText) {
                const textInfo = JSON.parse(savedText);
                document.getElementById('policyTitleInput').value = textInfo.title || ''; 
                document.getElementById('policyDescInput').value = textInfo.desc || '';
            }
            const list = db['esol_policy_history'] ? JSON.parse(db['esol_policy_history']) : [];
            const tbody = document.getElementById('adminPolicyHistoryBody');
            if (list.length === 0) return tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:15px; color:#888;">등록된 경영방침 이력이 없습니다.</td></tr>`;
            tbody.innerHTML = list.map(m => `<tr><td style="font-weight:bold;">${m.title}</td><td>${m.date}</td><td style="color:#1976d2; font-size:12px;">${m.fileName}</td><td style="text-align:center;"><button class="submit-btn" style="background:#d32f2f; padding:5px 10px; font-size:12px;" onclick="deletePolicyRevision('${m.id}')">삭제</button></td></tr>`).join('');
        }
        async function savePolicyText() {
            const title = document.getElementById('policyTitleInput').value.trim();
            const desc = document.getElementById('policyDescInput').value.trim();
            await saveDB('esol_policy_text', { title, desc }); alert('저장 완료');
        }
        async function uploadPolicyRevision() {
            const title = document.getElementById('policyRevTitle').value.trim();
            const date = document.getElementById('policyRevDate').value;
            const fileInput = document.getElementById('policyRevFile');
            if (!title || !date || !fileInput.files.length) return alert('모두 입력해주세요.');
            const file = fileInput.files[0];
            try {
                const base64Data = await readAsDataURL(file);
                const db = await fetchDB();
                const list = db['esol_policy_history'] ? JSON.parse(db['esol_policy_history']) : [];
                list.unshift({ id: Date.now().toString(), title, date, fileName: file.name, fileUrl: base64Data, type: file.name.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image' });
                await saveDB('esol_policy_history', list); alert('✅ 등록 완료');
                document.getElementById('policyRevTitle').value = ''; document.getElementById('policyRevDate').value = ''; fileInput.value = ''; renderAdminPolicy();
            } catch (err) { alert('업로드 에러 발생'); }
        }
        async function deletePolicyRevision(id) {
            if (!confirm('삭제하시겠습니까?')) return;
            const db = await fetchDB();
            let list = db['esol_policy_history'] ? JSON.parse(db['esol_policy_history']) : [];
            list = list.filter(m => m.id !== id); await saveDB('esol_policy_history', list); renderAdminPolicy();
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (document.getElementById('tab8').classList.contains('active')) renderAdminOrgTable();
            if (document.getElementById('tab9').classList.contains('active')) renderAdminCommittee();
            if (document.getElementById('tab10').classList.contains('active')) renderAdminEmergency();
            if (document.getElementById('tab11').classList.contains('active')) renderAdminContact();
            if (document.getElementById('tab12').classList.contains('active')) renderAdminPolicy();
            if (document.getElementById('tab13').classList.contains('active')) renderAdminLaw();
        });
    </script>
</body>
</html>